{
  "name": "heritage-theme",
  "version": "4.99.0",
  "private": true,
  "description": "Heritage 4.99 Shopify theme",
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./assets/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./assets/tailwind.css --watch",
    "build:js": "esbuild src/react/index.jsx --bundle --minify --format=iife --target=es2019 --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --legal-comments=none --outfile=assets/react-islands.js",
    "build": "npm run build:js && npm run build:css"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "3.4.17"
  }
}
