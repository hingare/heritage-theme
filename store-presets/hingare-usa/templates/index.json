        "q1": {
          "type": "question",
          "settings": {
            "question": "Is your leather genuine?",
            "answer": "<p>Yes. Every piece is made from genuine cowhide leather, cut and finished by hand in our workshop in Bangladesh.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "How should I care for my leather bag?",
            "answer": "<p>Keep it away from long exposure to water and direct heat, wipe it with a soft dry cloth, and condition the leather every few months. Read our full <a href=\"/pages/leather-care-guide\">leather care guide</a> for details.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Will the leather change over time?",
            "answer": "<p>Genuine leather softens and develops a natural patina with use. Small variations in grain and colour are a sign of real hide, so no two pieces are exactly alike.</p>"
          }
        }
      },
