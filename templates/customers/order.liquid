<div class="page-width">
  <div class="customer customer--wide">
    <p><a href="{{ routes.account_url }}" class="link-underline">{{ 'customer.account' | t }}</a></p>
    <h1>{{ 'customer.order' | t }} {{ order.name }}</h1>
    <p>{{ order.created_at | time_tag: format: 'date_at_time' }}</p>
    {%- if order.cancelled -%}<p class="form-message form-message--error">Cancelled: {{ order.cancel_reason_label }}</p>{%- endif -%}
    <table>
      <thead><tr><th>Product</th><th>SKU</th><th>Price</th><th>{{ 'products.product.quantity' | t }}</th><th>{{ 'customer.total' | t }}</th></tr></thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td>{{ line_item.title | link_to: line_item.product.url }}{% if line_item.fulfillment %}<br><small>{{ line_item.fulfillment.created_at | time_tag: format: 'date' }}{% if line_item.fulfillment.tracking_url %} · <a href="{{ line_item.fulfillment.tracking_url }}">{{ line_item.fulfillment.tracking_number }}</a>{% endif %}</small>{% endif %}</td>
            <td>{{ line_item.sku }}</td>
            <td>{{ line_item.final_price | money }}</td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr><td colspan="4">{{ 'cart.subtotal' | t }}</td><td>{{ order.line_items_subtotal_price | money }}</td></tr>
        {%- for discount in order.cart_level_discount_applications -%}<tr><td colspan="4">{{ discount.title }}</td><td>-{{ discount.total_allocated_amount | money }}</td></tr>{%- endfor -%}
        {%- for shipping_method in order.shipping_methods -%}<tr><td colspan="4">{{ shipping_method.title }}</td><td>{{ shipping_method.price | money }}</td></tr>{%- endfor -%}
        {%- for tax_line in order.tax_lines -%}<tr><td colspan="4">{{ tax_line.title }} ({{ tax_line.rate_percentage }}%)</td><td>{{ tax_line.price | money }}</td></tr>{%- endfor -%}
        <tr><td colspan="4"><strong>{{ 'customer.total' | t }}</strong></td><td><strong>{{ order.total_net_amount | money_with_currency }}</strong></td></tr>
      </tfoot>
    </table>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 2rem;">
      <div><h2 class="h4">Billing address</h2>{{ order.billing_address | format_address }}</div>
      <div><h2 class="h4">Shipping address</h2>{{ order.shipping_address | format_address }}</div>
    </div>
  </div>
</div>
