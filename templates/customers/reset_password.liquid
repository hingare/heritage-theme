<div class="page-width">
  <div class="customer">
    <h1 class="text-center">{{ 'customer.reset_password' | t }}</h1>
    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="field"><label for="ResetPassword">{{ 'customer.password' | t }}</label><input class="input" type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required></div>
      <div class="field"><label for="ResetPasswordConfirm">Confirm password</label><input class="input" type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required></div>
      <button type="submit" class="btn btn--full">{{ 'customer.reset_password' | t }}</button>
    {%- endform -%}
  </div>
</div>
