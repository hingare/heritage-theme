{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_card.title' | t }} &ndash; {{ shop.name }}</title>
    {{ settings.type_header_font | font_face: font_display: 'swap' }}
    {{ settings.type_body_font | font_face: font_display: 'swap' }}
    {% render 'css-variables' %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main class="page-width">
      <div class="gift-card">
        <h1>{{ shop.name }}</h1>
        <h2 class="h3">{{ 'gift_card.title' | t }}</h2>
        <p class="h1">{{ gift_card.balance | money }}</p>
        <p>{{ 'gift_card.code' | t }}</p>
        <div class="gift-card__code">{{ gift_card.code | format_code }}</div>
        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Add to Apple Wallet" style="margin: 0 auto;"></a>
        {%- endif -%}
        <div style="display: flex; gap: 0.75rem; justify-content: center;">
          <a href="{{ shop.url }}" class="btn">{{ 'general.continue_shopping' | t }}</a>
          <button type="button" class="btn btn--secondary" onclick="window.print();">{{ 'gift_card.print' | t }}</button>
        </div>
      </div>
    </main>
  </body>
</html>
