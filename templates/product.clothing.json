{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title",
          "settings": {}
        },
        "rating": {
          "type": "rating",
          "settings": {
            "show_empty": false,
            "link": "#shopify-product-reviews"
          }
        },
        "price": {
          "type": "price",
          "settings": {
            "show_save": true,
            "show_tax_note": true
          }
        },
        "divider": {
          "type": "divider",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "use_swatches": true
          }
        },
        "size_chart": {
          "type": "size_chart",
          "settings": {
            "label": "Size guide",
            "content": "<p><strong>How to measure</strong></p><ul><li><strong>Chest:</strong> around the fullest part of the chest.</li><li><strong>Waist:</strong> around the natural waistline.</li><li><strong>Length:</strong> from the top of the shoulder to the hem.</li></ul><p><strong>Sizes (chest, inches)</strong></p><ul><li>S: 36 to 38</li><li>M: 38 to 40</li><li>L: 40 to 42</li><li>XL: 42 to 44</li><li>XXL: 44 to 46</li></ul><p>Between sizes? Choose the larger size for a relaxed fit.</p>"
          }
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "low_threshold": 5
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_quantity": false,
            "show_dynamic": true,
            "show_installments": true,
            "show_gift_card_recipient": true
          }
        },
        "wishlist": {
          "type": "wishlist",
          "settings": {}
        },
        "delivery": {
          "type": "delivery",
          "settings": {
            "text": "Order today, delivered",
            "min_days": 3,
            "max_days": 7,
            "skip_weekends": true,
            "cutoff_hour": 14
          }
        },
        "trust_badges": {
          "type": "trust_badges",
          "settings": {
            "icon_1": "truck",
            "text_1": "Free shipping over $150",
            "icon_2": "return",
            "text_2": "Free size exchanges",
            "icon_3": "lock",
            "text_3": "Secure checkout"
          }
        },
        "description": {
          "type": "description",
          "settings": {
            "collapsible": true,
            "title": "Description",
            "open": true,
            "full_width_desktop": true
          }
        },
        "tab_fit": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Fit & sizing",
            "icon": "ruler",
            "content": "<p>Regular fit. The model is 6'0\" (183 cm) and wears size M. Use the size guide to find your size.</p>",
            "open": false
          }
        },
        "tab_fabric": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Fabric & care",
            "icon": "heart",
            "content": "<ul><li>Machine wash cold, inside out.</li><li>Do not bleach.</li><li>Hang to dry or tumble dry low.</li><li>Iron on low heat if needed.</li></ul>",
            "open": false
          }
        },
        "tab_shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping, exchanges & returns",
            "icon": "return",
            "content": "<p>Free US shipping on orders over $150. Wrong size? Exchange it free within 30 days. See our <a href=\"/policies/refund-policy\">refund policy</a>.</p>",
            "open": false
          }
        },
        "share": {
          "type": "share",
          "settings": {}
        }
      },
      "block_order": [
        "title",
        "rating",
        "price",
        "divider",
        "variant_picker",
        "size_chart",
        "inventory",
        "buy_buttons",
        "wishlist",
        "delivery",
        "trust_badges",
        "description",
        "tab_fit",
        "tab_fabric",
        "tab_shipping",
        "share"
      ],
      "settings": {
        "gallery_layout": "stacked",
        "show_badges": true,
        "media_size": "large",
        "image_ratio": "natural",
        "enable_zoom": true,
        "sticky_info": true,
        "sticky_atc": true,
        "show_breadcrumbs": true
      }
    },
    "complete-look": {
      "type": "product-recommendations",
      "settings": {
        "heading": "Complete the look",
        "intent": "complementary",
        "limit": 4,
        "columns": 4
      }
    },
    "faq": {
      "type": "faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "How do I find my size?",
            "answer": "<p>Open the size guide next to the size options. If you are between sizes, choose the larger one for a relaxed fit.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Can I exchange for another size?",
            "answer": "<p>Yes. Size exchanges are free within 30 days of delivery.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Will it shrink?",
            "answer": "<p>Wash cold and hang dry to keep the original size and color.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3"
      ],
      "settings": {
        "subheading": "Help",
        "heading": "Sizing & fit questions",
        "open_first": true,
        "contact_text": "<p>Still have a question? <a href=\"/pages/contact\">Contact us</a>.</p>",
        "enable_schema": false,
        "alt_bg": true,
        "color_scheme": "scheme-1"
      }
    },
    "recommendations": {
      "type": "product-recommendations",
      "settings": {
        "heading": "You may also like",
        "intent": "related",
        "limit": 4,
        "columns": 4
      }
    },
    "recently-viewed": {
      "type": "recently-viewed",
      "settings": {
        "heading": "Recently viewed",
        "limit": 4,
        "columns": 4
      }
    }
  },
  "order": [
    "main",
    "complete-look",
    "faq",
    "recommendations",
    "recently-viewed"
  ]
}
