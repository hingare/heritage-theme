{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "vendor"
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price",
          "settings": {
            "show_save": true,
            "show_tax_note": true
          }
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "low_threshold": 5
          }
        },
        "divider": {
          "type": "divider"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "use_swatches": true
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_quantity": true,
            "show_dynamic": true
          }
        },
        "trust_badges": {
          "type": "trust_badges",
          "settings": {
            "icon_1": "truck",
            "text_1": "Free shipping over $150",
            "icon_2": "return",
            "text_2": "30-day returns",
            "icon_3": "lock",
            "text_3": "Secure checkout"
          }
        },
        "description": {
          "type": "description",
          "settings": {
            "collapsible": true,
            "title": "Description",
            "open": true
          }
        },
        "tab_shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & returns",
            "icon": "truck",
            "content": "<p>Orders ship within 1–2 business days. Returns are accepted within 30 days of delivery.</p>",
            "open": false
          }
        },
        "share": {
          "type": "share"
        },
        "wishlist": {
          "type": "wishlist"
        },
        "complementary": {
          "type": "complementary",
          "settings": {
            "heading": "Pairs well with",
            "limit": 3
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "inventory",
        "divider",
        "variant_picker",
        "buy_buttons",
        "wishlist",
        "trust_badges",
        "description",
        "tab_shipping",
        "complementary",
        "share"
      ],
      "settings": {
        "gallery_layout": "thumbnails",
        "media_size": "large",
        "image_ratio": "product",
        "enable_zoom": true,
        "sticky_info": true,
        "sticky_atc": true,
        "show_breadcrumbs": true
      }
    },
    "recommendations": {
      "type": "product-recommendations",
      "settings": {
        "heading": "You may also like",
        "intent": "related",
        "limit": 4,
        "columns": 4
      }
    },
    "recently-viewed": {
      "type": "recently-viewed",
      "settings": {
        "heading": "Recently viewed",
        "limit": 4,
        "columns": 4
      }
    }
  },
  "order": [
    "main",
    "recommendations",
    "recently-viewed"
  ]
}
