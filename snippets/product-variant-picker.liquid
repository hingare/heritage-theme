{%- comment -%}
  Variant picker: buttons, colour swatches or dropdowns.
  - product (required), section (required)
  - picker_type: 'button' | 'dropdown'
  - use_swatches: boolean
  - swatch_style: 'color' | 'image' | 'image_label' (variant photo instead of colour)
  - swatch_shape: 'circle' | 'square'
  - swatch_size: number (px)
{%- endcomment -%}
{%- liquid
  assign swatch_style = swatch_style | default: 'color'
  assign swatch_shape = swatch_shape | default: 'circle'
  assign swatch_size = swatch_size | default: 38
-%}
{%- unless product.has_only_default_variant -%}
  <div class="variant-picker" data-variant-picker>
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign option_lower = option.name | downcase
        assign swatch_lower = settings.swatch_option_name | downcase
        assign is_swatch = false
        if use_swatches and option_lower == swatch_lower
          assign is_swatch = true
        endif
        assign option_index = forloop.index0
      -%}
      {%- if picker_type == 'dropdown' and is_swatch == false -%}
        <div class="field" data-option-index="{{ option_index }}">
          <label for="Option-{{ section.id }}-{{ option_index }}">{{ option.name }}</label>
          <select id="Option-{{ section.id }}-{{ option_index }}" class="select" name="options[{{ option.name | escape }}]">
            {%- for value in option.values -%}
              <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
            {%- endfor -%}
          </select>
        </div>
      {%- else -%}
        <fieldset data-option-index="{{ option_index }}">
          <legend>{{ option.name }}:<span data-selected-value>{{ option.selected_value }}</span></legend>
          <div class="variant-picker__options{% if is_swatch %} variant-picker__options--{{ swatch_style }} variant-picker__options--{{ swatch_shape }}{% endif %}"{% if is_swatch %} style="--swatch-size: {{ swatch_size }}px;"{% endif %}>
            {%- for value in option.values -%}
              {%- liquid
                assign swatch_img = nil
                if is_swatch and swatch_style != 'color'
                  for v in product.variants
                    if v.options[option_index] == value and v.featured_image
                      assign swatch_img = v.featured_image
                      break
                    endif
                  endfor
                endif
              -%}
              <label class="{% if is_swatch %}variant-swatch{% if swatch_img %} variant-swatch--image{% endif %}{% else %}variant-pill{% endif %}" title="{{ value | escape }}">
                <input type="radio" name="{{ section.id }}-{{ option.name | handle }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                {%- if is_swatch -%}
                  {%- if swatch_img -%}
                    <span class="variant-swatch__chip">{{ swatch_img | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100, 200', sizes: '80px', alt: '' }}</span>
                  {%- else -%}
                    <span class="variant-swatch__chip" style="--swatch-color: {% render 'swatch-color', value: value %}"></span>
                  {%- endif -%}
                  {%- if swatch_style == 'image_label' -%}
                    <span class="variant-swatch__label">{{ value }}</span>
                  {%- else -%}
                    <span class="visually-hidden">{{ value }}</span>
                  {%- endif -%}
                {%- else -%}
                  <span>{{ value }}</span>
                {%- endif -%}
              </label>
            {%- endfor -%}
          </div>
        </fieldset>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endunless -%}
