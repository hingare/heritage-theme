{%- comment -%}
  Video slideshow helper: prints the slideshow's layout classes from its settings.
  - s: the section settings
{%- endcomment -%}
vslideshow vslideshow--{{ s.height }} vslideshow--mobile-{{ s.mobile_height }} vslideshow--{{ s.transition }} vslideshow--fit-{{ s.video_fit | default: 'contain' }} vslideshow--fit-m-{{ s.mobile_video_fit | default: 'contain' }} vslideshow--m-text-{{ s.mobile_text_placement | default: 'overlay' }}{%- if s.mobile_text_align != blank and s.mobile_text_align != 'same' %} vslideshow--m-align-{{ s.mobile_text_align }}{%- endif -%}{%- if s.mobile_text_position != blank and s.mobile_text_position != 'same' %} vslideshow--m-pos-{{ s.mobile_text_position }}{%- endif -%}{%- if s.mobile_custom_overlay %} vslideshow--m-overlay{%- endif -%}{%- if s.mobile_show_dots == false %} vslideshow--m-no-dots{%- endif -%}{%- if s.mobile_show_buttons == false %} vslideshow--m-no-buttons{%- endif -%}{%- if s.mobile_show_progress == false %} vslideshow--m-no-progress{%- endif -%}{%- if s.mobile_hide_text %} vslideshow--m-no-text{%- endif -%}{%- if s.mobile_text_color != blank %} vslideshow--m-color{%- endif -%}{%- if s.show_controls_hover %} vslideshow--controls-hover{%- endif -%}
