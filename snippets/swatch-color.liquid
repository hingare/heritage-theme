{%- comment -%}
  Outputs a CSS colour for a product option value.
  Uses the value's native swatch when set in Shopify admin, otherwise
  falls back to a small map of common leather and fashion colour names.
{%- endcomment -%}
{%- liquid
  if value.swatch.color
    echo value.swatch.color
  elsif value.swatch.image
    assign swatch_img = value.swatch.image | image_url: width: 80
    echo 'url(' | append: swatch_img | append: ')'
  else
    assign key = value | downcase | strip
    case key
      when 'black'
        echo '#151515'
      when 'brown', 'dark brown', 'chocolate'
        echo '#5b3a24'
      when 'red brown', 'cognac', 'tan brown'
        echo '#8a4128'
      when 'tan', 'camel'
        echo '#b07a45'
      when 'coffee'
        echo '#4a2f22'
      when 'burgundy', 'wine', 'maroon'
        echo '#6b1f2a'
      when 'navy', 'navy blue'
        echo '#1f2a44'
      when 'blue'
        echo '#2f5d9e'
      when 'green', 'olive'
        echo '#4f5d3a'
      when 'grey', 'gray'
        echo '#8c8c8c'
      when 'white', 'off white', 'cream', 'ivory'
        echo '#f3eee4'
      when 'beige'
        echo '#d8c3a5'
      when 'red'
        echo '#b23a2b'
      when 'pink'
        echo '#e4a6b5'
      when 'yellow', 'mustard'
        echo '#d4a52c'
      else
        echo key | split: ' ' | last
    endcase
  endif
-%}
