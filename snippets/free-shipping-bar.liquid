{%- comment -%}
  Free shipping progress bar.
  - location: 'drawer' | 'cart' (each can be turned off in Theme settings > Cart)
{%- endcomment -%}
{%- liquid
  assign fs_show = settings.free_shipping_enabled
  if settings.free_shipping_threshold <= 0
    assign fs_show = false
  endif
  if location == 'drawer' and settings.free_shipping_drawer == false
    assign fs_show = false
  endif
  if location == 'cart' and settings.free_shipping_cart_page == false
    assign fs_show = false
  endif
-%}
{%- if fs_show -%}
  {%- liquid
    assign threshold = settings.free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign progress = cart.total_price | times: 100.0 | divided_by: threshold
    if progress > 100
      assign progress = 100
    endif
  -%}
  <div class="free-shipping{% if remaining <= 0 %} free-shipping--done{% endif %}"{% if settings.free_shipping_bar_color != blank %} style="--fs-color: {{ settings.free_shipping_bar_color }}"{% endif %}>
    {%- if remaining > 0 -%}
      {%- assign remaining_money = remaining | money -%}
      {%- if settings.free_shipping_text != blank -%}
        {{ settings.free_shipping_text | escape | replace: '[amount]', remaining_money }}
      {%- else -%}
        {{ 'cart.free_shipping_remaining' | t: amount: remaining_money }}
      {%- endif -%}
    {%- else -%}
      {%- if settings.free_shipping_success_text != blank -%}
        {{ settings.free_shipping_success_text | escape }}
      {%- else -%}
        {{ 'cart.free_shipping_reached' | t }}
      {%- endif -%}
    {%- endif -%}
    <div class="free-shipping__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress | round }}"><span style="width: {{ progress }}%"></span></div>
  </div>
{%- endif -%}
