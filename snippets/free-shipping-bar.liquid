{%- if settings.free_shipping_threshold > 0 -%}
  {%- liquid
    assign threshold = settings.free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign progress = cart.total_price | times: 100.0 | divided_by: threshold
    if progress > 100
      assign progress = 100
    endif
  -%}
  <div class="free-shipping">
    {%- if remaining > 0 -%}
      {{ 'cart.free_shipping_remaining' | t: amount: remaining | money }}
    {%- else -%}
      {{ 'cart.free_shipping_reached' | t }}
    {%- endif -%}
    <div class="free-shipping__bar"><span style="width: {{ progress }}%"></span></div>
  </div>
{%- endif -%}
