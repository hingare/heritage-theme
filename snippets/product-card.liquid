{%- comment -%}
  Product tile used across grids.
  - product: product object (required)
  - sizes: image sizes attribute
  - lazy: boolean (default true)
{%- endcomment -%}
{%- liquid
  assign sizes = sizes | default: '(min-width: 990px) 25vw, 50vw'
  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif
  assign secondary = nil
  assign card_alt = product.featured_media.alt | default: product.title | escape
  if settings.product_card_hover_image and product.media.size > 1
    assign secondary = product.media[1]
  endif
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
  assign swatch_option = nil
  if settings.swatches_enabled
    for option in product.options_with_values
      assign option_name = option.name | downcase
      assign swatch_name = settings.swatch_option_name | downcase
      if option_name == swatch_name
        assign swatch_option = option
      endif
    endfor
  endif
-%}
<div class="product-card" data-reveal>
  <a href="{{ product.url }}" class="product-card__media" tabindex="-1" aria-hidden="true">
    <div class="media media--product{% if secondary %} media--has-secondary{% endif %}">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 900 | image_tag: loading: loading, sizes: sizes, widths: '300, 450, 600, 900', alt: card_alt, class: 'product-card__image--primary' }}
        {%- if secondary -%}
          {{ secondary | image_url: width: 900 | image_tag: loading: 'lazy', sizes: sizes, widths: '300, 450, 600, 900', alt: '', class: 'product-card__image--secondary' }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </a>

  <div class="product-card__badges">
    {%- if product.available == false -%}
      <span class="badge badge--sold-out">{{ 'products.product.sold_out' | t }}</span>
    {%- elsif on_sale -%}
      <span class="badge badge--sale">
        {%- if settings.sale_badge_percent -%}
          {%- assign percent = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
          -{{ percent }}%
        {%- else -%}
          {{ 'products.product.sale' | t }}
        {%- endif -%}
      </span>
    {%- endif -%}
    {%- for tag in product.tags -%}
      {%- assign tag_lower = tag | downcase -%}
      {%- if tag_lower == 'new' or tag_lower == 'badge:new' -%}
        <span class="badge">{{ 'products.product.new' | t }}</span>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {% render 'wishlist-button', product: product, class: 'product-card__wishlist' %}

  {%- if settings.quick_view_enabled or settings.quick_add_enabled -%}
    <div class="product-card__actions">
      {%- if settings.quick_view_enabled -%}
        <button type="button" class="btn btn--small" data-quick-view="{{ product.url }}">{{ 'products.product.quick_view' | t }}</button>
      {%- endif -%}
      {%- if settings.quick_add_enabled and product.available -%}
        {%- if product.has_only_default_variant -%}
          <button type="button" class="btn btn--small" data-quick-add="{{ product.selected_or_first_available_variant.id }}">{{ 'products.product.quick_add' | t }}</button>
        {%- else -%}
          <button type="button" class="btn btn--small" data-quick-view="{{ product.url }}">{{ 'products.product.quick_add' | t }}</button>
        {%- endif -%}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="product-card__info">
    {%- if settings.product_card_vendor -%}
      <span class="product-card__vendor">{{ product.vendor }}</span>
    {%- endif -%}
    <a href="{{ product.url }}" class="product-card__title">{{ product.title }}</a>
    {% render 'price', product: product %}
    {%- if swatch_option and swatch_option.values.size > 1 -%}
      <div class="product-card__swatches">
        {%- for value in swatch_option.values limit: 6 -%}
          <span class="swatch-dot" title="{{ value | escape }}" style="--swatch-color: {% render 'swatch-color', value: value %}"></span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>
