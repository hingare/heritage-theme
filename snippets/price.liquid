{%- comment -%}
  Renders product or variant price.
  - product: product object (required)
  - variant: optional variant, defaults to selected or first available
  - large: boolean, use larger text
  - show_save: boolean, show the savings label
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign price = target.price
  assign compare = target.compare_at_price
  if variant == blank and product.price_varies and large != true
    assign price = product.price_min
    assign compare = product.compare_at_price_min
  endif
  assign on_sale = false
  if compare > price
    assign on_sale = true
  endif
-%}
<div class="price{% if large %} price--large{% endif %}">
  {%- if on_sale -%}
    <span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>
    <span class="price__sale">
      {%- if variant == blank and product.price_varies and large != true -%}
        {{ 'products.product.from_price' | t: price: price | money }}
      {%- else -%}
        {{ price | money }}
      {%- endif -%}
    </span>
    <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
    <s class="price__compare">{{ compare | money }}</s>
    {%- if show_save -%}
      {%- liquid
        assign savings = compare | minus: price
        if settings.sale_badge_percent
          assign percent = savings | times: 100.0 | divided_by: compare | round
          assign save_label = 'products.product.save_percent' | t: percent: percent
        else
          assign save_label = 'products.product.save' | t: amount: savings | money
        endif
      -%}
      <span class="price__save">{{ save_label }}</span>
    {%- endif -%}
  {%- else -%}
    <span class="price__regular">
      {%- if variant == blank and product.price_varies and large != true -%}
        {{ 'products.product.from_price' | t: price: price | money }}
      {%- else -%}
        {{ price | money }}
      {%- endif -%}
    </span>
  {%- endif -%}
</div>
