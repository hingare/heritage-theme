{%- comment -%}
  Renders product or variant price.
  - product: product object (required)
  - variant: optional variant, defaults to selected or first available
  - large: boolean, use larger text
  - show_save: boolean, show the savings label
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign price = target.price
  assign compare = target.compare_at_price
  if variant == blank and product.price_varies and large != true
    assign price = product.price_min
    assign compare = product.compare_at_price_min
  endif
  assign on_sale = false
  if compare > price
    assign on_sale = true
  endif
  if settings.show_currency_code
    assign price_money = price | money_with_currency
    assign compare_money = compare | money_with_currency
  else
    assign price_money = price | money
    assign compare_money = compare | money
  endif
-%}
<div class="price{% if large %} price--large{% endif %}">
  {%- if on_sale -%}
    <span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>
    <span class="price__sale">
      {%- if variant == blank and product.price_varies and large != true -%}
        {{ 'products.product.from_price' | t: price: price_money }}
      {%- else -%}
        {{ price_money }}
      {%- endif -%}
    </span>
    <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
    <s class="price__compare">{{ compare_money }}</s>
    {%- if show_save -%}
      {%- liquid
        assign savings = compare | minus: price
        if settings.sale_badge_percent
          assign percent = savings | times: 100.0 | divided_by: compare | round
          assign save_label = 'products.product.save_percent' | t: percent: percent
        else
          assign savings_money = savings | money
          assign save_label = 'products.product.save' | t: amount: savings_money
        endif
      -%}
      <span class="price__save">{{ save_label }}</span>
    {%- endif -%}
  {%- else -%}
    <span class="price__regular">
      {%- if variant == blank and product.price_varies and large != true -%}
        {{ 'products.product.from_price' | t: price: price_money }}
      {%- else -%}
        {{ price_money }}
      {%- endif -%}
    </span>
  {%- endif -%}
  {%- if target.unit_price_measurement and large -%}
    <span class="price__unit">
      {%- liquid
        assign unit_money = target.unit_price | money
        assign ref = target.unit_price_measurement.reference_value
      -%}
      {{ unit_money }}/{% if ref != 1 %}{{ ref }}{% endif %}{{ target.unit_price_measurement.reference_unit }}
    </span>
  {%- endif -%}
</div>
