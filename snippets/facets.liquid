{%- comment -%}
  Storefront filtering form. Requires the Shopify Search & Discovery app
  (or default filters) to be configured.
  - results: collection or search object
{%- endcomment -%}
<form class="facets" data-facets-form>
  {%- if results.terms -%}<input type="hidden" name="q" value="{{ results.terms | escape }}">{%- endif -%}
  <div data-facets-body>
    {%- for filter in results.filters -%}
      {%- liquid
        assign group_open = false
        if collapsed != true and forloop.index <= 3
          assign group_open = true
        endif
        if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value
          assign group_open = true
        endif
      -%}
      <details class="facets__group"{% if group_open %} open{% endif %}>
        <summary class="facets__summary">
          <span>{{ filter.label }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}</span>
          {% render 'icon', name: 'chevron-down' %}
        </summary>
        {%- case filter.type -%}
          {%- when 'price_range' -%}
            {%- liquid
              assign min_value = filter.min_value.value | divided_by: 100.0 | round
              assign max_value = filter.max_value.value | divided_by: 100.0 | round
              assign range_max = filter.range_max | divided_by: 100.0 | ceil
            -%}
            <div class="facets__range" data-price-range>
              <input type="range" min="0" max="{{ range_max }}" step="1" value="{{ min_value | default: 0 }}" aria-label="{{ 'collections.from' | t }}" data-range-min tabindex="-1">
              <input type="range" min="0" max="{{ range_max }}" step="1" value="{% if filter.max_value.value %}{{ max_value }}{% else %}{{ range_max }}{% endif %}" aria-label="{{ 'collections.to' | t }}" data-range-max tabindex="-1">
            </div>
            <div class="facets__price">
              <div class="field">
                <label for="Filter-{{ filter.param_name }}-gte">{{ 'collections.from' | t }} {{ cart.currency.symbol }}</label>
                <input class="input" type="number" id="Filter-{{ filter.param_name }}-gte" name="{{ filter.min_value.param_name }}" {% if filter.min_value.value %}value="{{ min_value }}"{% endif %} placeholder="0" min="0" max="{{ range_max }}">
              </div>
              <div class="field">
                <label for="Filter-{{ filter.param_name }}-lte">{{ 'collections.to' | t }} {{ cart.currency.symbol }}</label>
                <input class="input" type="number" id="Filter-{{ filter.param_name }}-lte" name="{{ filter.max_value.param_name }}" {% if filter.max_value.value %}value="{{ max_value }}"{% endif %} placeholder="{{ range_max }}" min="0" max="{{ range_max }}">
              </div>
            </div>
          {%- else -%}
            {%- if filter.presentation == 'swatch' -%}
              <div class="facets__swatches">
                {%- for value in filter.values -%}
                  <label class="facets__swatch" title="{{ value.label | escape }} ({{ value.count }})">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                    {%- liquid
                      if value.swatch.image
                        assign swatch_img = value.swatch.image | image_url: width: 80
                        assign swatch_bg = 'url(' | append: swatch_img | append: ')'
                      else
                        assign swatch_bg = value.swatch.color | default: '#ccc'
                      endif
                    -%}
                    <span style="--swatch-color: {{ swatch_bg }}"></span>
                    <span class="visually-hidden">{{ value.label }}</span>
                  </label>
                {%- endfor -%}
              </div>
            {%- else -%}
              <ul class="facets__list">
                {%- for value in filter.values -%}
                  <li>
                    <label class="facets__option{% if value.count == 0 and value.active == false %} facets__option--disabled{% endif %}">
                      <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                      <span>{{ value.label }} <span class="facets__option-count">({{ value.count }})</span></span>
                    </label>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
        {%- endcase -%}
      </details>
    {%- endfor -%}
  </div>
  <noscript><button type="submit" class="btn btn--full">{{ 'collections.apply' | t }}</button></noscript>
</form>
