{%- assign blog = section.settings.blog -%}
<div class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width">
    <div class="section-header">
      <h2>{{ section.settings.heading }}</h2>
      {%- if blog != blank -%}<a href="{{ blog.url }}" class="section-header__link">{{ 'general.view_all' | t }}</a>{%- endif -%}
    </div>
    <div class="grid grid--scroll-mobile" style="--cols: 3;">
      {%- if blog != blank and blog.articles_count > 0 -%}
        {%- for article in blog.articles limit: section.settings.limit -%}
          {% render 'article-card', article: article %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="article-card">
            <div class="media media--landscape">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <h3 class="article-card__title">Blog post title</h3>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Blog posts",
  "class": "section-blog-posts",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the journal" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "limit", "label": "Posts to show", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "alt_bg", "label": "Use alternate background", "default": false }
  ],
  "presets": [ { "name": "Blog posts" } ]
}
{% endschema %}
