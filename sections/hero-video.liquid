<div class="hero-video" style="min-height: {{ section.settings.height }}px;">
  {%- if section.settings.video != blank -%}
    {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1920x' }}
  {%- elsif section.settings.video_url != blank -%}
    {%- if section.settings.video_url.type == 'youtube' -%}
      <iframe src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&mute=1&loop=1&controls=0&playlist={{ section.settings.video_url.id }}&playsinline=1" allow="autoplay; encrypted-media" title="{{ section.settings.heading | escape }}" loading="lazy"></iframe>
    {%- else -%}
      <iframe src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1&muted=1&loop=1&background=1" allow="autoplay" title="{{ section.settings.heading | escape }}" loading="lazy"></iframe>
    {%- endif -%}
  {%- elsif section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '100vw' }}
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
  {%- endif -%}
  <div class="slide__overlay" style="--overlay-opacity: {{ section.settings.overlay | divided_by: 100.0 }}; z-index: 1;"></div>
  <div class="hero-video__content">
    {%- if section.settings.subheading != blank -%}<span class="subheading">{{ section.settings.subheading }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="slide__heading">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.link | default: '#' }}" class="btn btn--light">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Background video",
  "class": "section-hero-video",
  "settings": [
    { "type": "video", "id": "video", "label": "Video (uploaded)" },
    { "type": "video_url", "id": "video_url", "label": "Or YouTube / Vimeo URL", "accept": ["youtube", "vimeo"] },
    { "type": "image_picker", "id": "image", "label": "Fallback image" },
    { "type": "range", "id": "height", "label": "Height", "min": 300, "max": 900, "step": 20, "unit": "px", "default": 600 },
    { "type": "range", "id": "overlay", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30 },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made by hand" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [ { "name": "Background video" } ]
}
{% endschema %}
