<div class="page-width" data-collection-container data-section-id="{{ section.id }}" style="padding-bottom: 4rem;">
  <div class="page-header">
    <h1>{% if search.performed %}{{ 'search.results_for' | t: terms: search.terms }}{% else %}{{ 'search.title' | t }}{% endif %}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" style="max-width: 560px; margin: 1.5rem auto 0; display: flex;">
      <input type="hidden" name="options[prefix]" value="last">
      <input class="input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'header.search_placeholder' | t }}" aria-label="{{ 'general.search' | t }}">
      <button type="submit" class="btn">{{ 'general.search' | t }}</button>
    </form>
  </div>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      {%- if search.results_count == 0 -%}
        <p class="text-center">{{ 'search.no_results' | t: terms: search.terms }}</p>
      {%- else -%}
        <div class="collection-toolbar">
          <span class="collection-toolbar__count" data-collection-count>{{ 'collections.products_count' | t: count: search.results_count }}</span>
        </div>
        <div class="collection-grid" data-collection-results>
          <div class="grid" style="--cols: 4;">
            {%- for item in search.results -%}
              {%- case item.object_type -%}
                {%- when 'product' -%}
                  {% render 'product-card', product: item %}
                {%- when 'article' -%}
                  {% render 'article-card', article: item %}
                {%- when 'page' -%}
                  <a href="{{ item.url }}" class="article-card">
                    <div class="media media--landscape" style="display:flex;align-items:center;justify-content:center;"><span class="h3" style="position:relative;">{{ item.title }}</span></div>
                  </a>
              {%- endcase -%}
            {%- endfor -%}
          </div>
          {% render 'pagination', paginate: paginate %}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search results",
  "settings": []
}
{% endschema %}
