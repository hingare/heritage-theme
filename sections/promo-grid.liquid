{%- comment -%}
  Promotional grid: flexible tiles with a width (in 12ths) and height each,
  plus banner and product tiles.
{%- endcomment -%}
<div class="section color-{{ section.settings.color_scheme }}{% if section.settings.full_width %} section--flush{% endif %}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="{% if section.settings.full_width %}{% else %}page-width{% endif %}">
    <div class="promo-grid{% if section.settings.mobile_layout == 'swipe' and section.blocks.size > 1 %} promo-grid--swipe{% endif %}" style="--promo-gap: {{ section.settings.gap }}px;">
      {%- for block in section.blocks -%}
        {%- liquid
          assign span = block.settings.width | default: 6
          assign content_class = ''
          if block.settings.text_position == 'center'
            assign content_class = 'promo-grid__content--center'
          elsif block.settings.text_position == 'top'
            assign content_class = 'promo-grid__content--top'
          endif
        -%}
        {%- case block.type -%}
          {%- when 'advanced' -%}
            <div class="promo-grid__item" data-reveal style="--span: {{ span }}; --promo-height: {{ block.settings.height }}px; --promo-height-mobile: {{ block.settings.height | times: 0.75 | round }}px; --promo-text: {{ block.settings.text_color }}; --promo-bg: {{ block.settings.bg_color }}; --overlay-opacity: {{ block.settings.overlay | divided_by: 100.0 }};" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <div class="promo-grid__media">
                  {%- liquid
                    assign promo_sizes = span | times: 8.33 | round | append: 'vw'
                    assign promo_loading = 'lazy'
                    assign promo_priority = 'auto'
                    if section.index == 1 and forloop.index <= 3
                      assign promo_loading = 'eager'
                      if forloop.first
                        assign promo_priority = 'high'
                      endif
                    endif
                  -%}
                  {{ block.settings.image | image_url: width: 1800 | image_tag: loading: promo_loading, fetchpriority: promo_priority, widths: '450, 750, 1100, 1500, 1800', sizes: promo_sizes, alt: block.settings.image.alt }}
                </div>
                <div class="promo-grid__overlay"></div>
              {%- elsif block.settings.bg_color == blank -%}
                <div class="promo-grid__media">{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                <div class="promo-grid__overlay"></div>
              {%- endif -%}
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="promo-grid__link-cover" aria-label="{{ block.settings.heading | escape }}"></a>{%- endif -%}
              <div class="promo-grid__content {{ content_class }}">
                {%- if block.settings.subheading != blank -%}<span class="subheading">{{ block.settings.subheading }}</span>{%- endif -%}
                {%- if block.settings.heading != blank -%}<h3 class="promo-grid__heading">{{ block.settings.heading }}</h3>{%- endif -%}
                {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <a href="{{ block.settings.link | default: '#' }}" class="btn btn--light">{{ block.settings.button_label }}</a>
                {%- endif -%}
              </div>
            </div>
          {%- when 'banner' -%}
            <div class="promo-grid__item promo-grid__item--banner" data-reveal style="--span: 12; --promo-text: {{ block.settings.text_color }}; --promo-bg: {{ block.settings.bg_color }};" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="promo-grid__link-cover" aria-label="{{ block.settings.heading | escape }}"></a>{%- endif -%}
              <div class="promo-grid__content" style="padding: 1.5rem 2rem;">
                <h3 class="promo-grid__heading">{{ block.settings.heading }}</h3>
                {%- if block.settings.text != blank -%}<div>{{ block.settings.text }}</div>{%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <a href="{{ block.settings.link | default: '#' }}" class="btn btn--small btn--secondary" style="color: inherit; margin: 0;">{{ block.settings.button_label }}</a>
                {%- endif -%}
              </div>
            </div>
          {%- when 'product' -%}
            {%- assign promo_product = block.settings.product -%}
            <div class="promo-grid__item promo-grid__item--product" data-reveal style="--span: {{ span }}; --promo-height: {{ block.settings.height }}px; --promo-bg: {{ block.settings.bg_color }};" {{ block.shopify_attributes }}>
              <div class="promo-grid__product">
                <a href="{{ promo_product.url }}" class="media media--square">
                  {%- if promo_product.featured_media -%}
                    {{ promo_product.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '30vw', widths: '300, 600, 900', alt: promo_product.title }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </a>
                <div>
                  {%- if block.settings.label != blank -%}<span class="subheading">{{ block.settings.label }}</span>{%- endif -%}
                  <h3 class="promo-grid__heading" style="color: inherit;">{{ promo_product.title | default: 'Your product' }}</h3>
                  {%- if promo_product -%}{% render 'price', product: promo_product %}{%- endif -%}
                  <a href="{{ promo_product.url | default: '#' }}" class="btn" style="margin-top: 1rem;">{{ block.settings.button_label }}</a>
                </div>
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Promotion grid",
  "class": "section-promo-grid",
  "max_blocks": 12,
  "settings": [
    {
      "type": "checkbox",
