<div id="NewsletterPopup" class="modal popup" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ section.settings.heading | escape }}" data-popup data-delay="{{ section.settings.delay }}" data-frequency="{{ section.settings.frequency }}" data-design-mode="{{ request.design_mode }}">
  <div class="modal__backdrop"></div>
  <div class="modal__dialog popup__dialog{% if section.settings.image != blank %} popup__dialog--image{% endif %}">
    <button type="button" class="modal__close" data-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    {%- if section.settings.image != blank -%}
      {%- assign popup_alt = section.settings.image.alt | escape -%}
      <div class="popup__image">
        {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 360px, 100vw', widths: '450, 700, 900', alt: popup_alt }}
      </div>
    {%- endif -%}
    <div class="popup__content">
      {%- if section.settings.subheading != blank -%}<span class="subheading">{{ section.settings.subheading }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h3">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte tw-mb-5">{{ section.settings.text }}</div>{%- endif -%}
      {% render 'newsletter-form', form_id: 'NewsletterPopupForm' %}
      {%- if section.settings.disclaimer != blank -%}<p class="tw-text-xs tw-opacity-70 tw-mt-4 tw-mb-0">{{ section.settings.disclaimer }}</p>{%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter popup",
  "class": "section-newsletter-popup",
  "limit": 1,
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "range", "id": "delay", "label": "Show after", "min": 2, "max": 60, "step": 1, "unit": "s", "default": 8 },
    { "type": "range", "id": "frequency", "label": "Show again after", "min": 1, "max": 60, "step": 1, "unit": "d", "default": 14, "info": "Never shown again after someone subscribes" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Join the list" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 10% off your first order" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Be first to hear about new arrivals, restocks and private sales.</p>" },
    { "type": "text", "id": "disclaimer", "label": "Small print", "default": "You can unsubscribe at any time." },
    { "type": "paragraph", "content": "Create the matching discount code in Discounts and send it with your welcome email." }
  ],
  "presets": [ { "name": "Newsletter popup" } ]
}
{% endschema %}
