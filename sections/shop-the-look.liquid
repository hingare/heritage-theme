{%- liquid
  assign st = section.settings
  assign stl_mode = st.hotspot_action | default: 'popup'
  assign stl_list = st.show_product_list
-%}
<div class="section color-{{ st.color_scheme }}{% if st.alt_bg %} section--alt{% endif %}">
  <div class="page-width">
    {%- if st.heading != blank or st.subheading != blank -%}
      <div class="section-header section-header--center">
        {%- if st.subheading != blank -%}<span class="subheading">{{ st.subheading }}</span>{%- endif -%}
        {%- if st.heading != blank -%}<h2>{{ st.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="stl{% if stl_list %} stl--with-list stl--image-{{ st.image_position | default: 'left' }}{% else %} stl--image-only{% endif %}" data-hotspots data-mode="{{ stl_mode }}"{% if st.hotspot_color != blank %} style="--hotspot-color: {{ st.hotspot_color }}"{% endif %}>
      <div class="stl__image media media--{{ st.image_ratio }} tw-overflow-visible" data-reveal>
        {%- if st.image != blank -%}
          {%- assign look_alt = st.image.alt | escape -%}
          {{ st.image | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 60vw, 100vw', widths: '600, 900, 1200, 1800', alt: look_alt, class: 'tw-rounded-card' }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          <button type="button" class="hotspot hotspot--{{ st.hotspot_style | default: 'dot' }}" style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%;" data-hotspot="{{ forloop.index0 }}" aria-label="{{ p.title | default: 'Product' | escape }}"{% if stl_mode == 'popup' %} aria-expanded="false" aria-controls="HotspotPop-{{ block.id }}"{% endif %} {{ block.shopify_attributes }}>
            <span class="hotspot__dot">{% if st.hotspot_style == 'number' %}{{ forloop.index }}{% elsif st.hotspot_style == 'plus' %}{% render 'icon', name: 'plus' %}{% endif %}</span>
          </button>
          {%- if stl_mode == 'popup' -%}
            <div id="HotspotPop-{{ block.id }}" class="hotspot-pop{% if block.settings.x > 55 %} hotspot-pop--left{% endif %}{% if block.settings.y > 55 %} hotspot-pop--up{% endif %}" style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%;" data-hotspot-pop="{{ forloop.index0 }}" hidden>
              <button type="button" class="hotspot-pop__close" data-hotspot-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
              <a href="{{ p.url | default: '#' }}" class="hotspot-pop__media">
                {%- if p.featured_media -%}
                  {{ p.featured_media | image_url: width: 400 | image_tag: loading: 'lazy', sizes: '220px', alt: '' }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>
              <div class="hotspot-pop__info">
                <a href="{{ p.url | default: '#' }}" class="hotspot-pop__title">{{ p.title | default: 'Choose a product' }}</a>
                {%- if p -%}{% render 'price', product: p %}{%- endif -%}
                {%- if p and st.popup_add_to_cart -%}
                  {%- if p.available and p.has_only_default_variant -%}
                    <form action="{{ routes.cart_add_url }}" method="post" data-product-form data-ajax="true" class="hotspot-pop__form">
                      <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                      <input type="hidden" name="quantity" value="1">
                      <button type="submit" class="btn btn--small btn--full">{{ 'products.product.add_to_cart' | t }}</button>
                    </form>
                  {%- elsif p.available and settings.quick_view_enabled -%}
                    <button type="button" class="btn btn--small btn--full" data-quick-view="{{ p.url }}">{{ 'products.product.quick_add' | t }}</button>
                  {%- else -%}
                    <a href="{{ p.url }}" class="btn btn--small btn--secondary btn--full">{{ 'video.shop' | t }}</a>
                  {%- endif -%}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if stl_list or st.button_label != blank -%}
        <div class="stl__list tw-flex tw-flex-col tw-gap-3">
          {%- if stl_list -%}
            {%- for block in section.blocks -%}
              {%- assign p = block.settings.product -%}
              <a href="{{ p.url | default: '#' }}" class="hotspot-card" data-hotspot-card="{{ forloop.index0 }}">
                <span class="tw-text-sm tw-font-semibold tw-w-7 tw-h-7 tw-rounded-full tw-border tw-border-line tw-grid tw-place-items-center tw-shrink-0">{{ forloop.index }}</span>
                <span class="media media--square tw-w-20 tw-shrink-0">
                  {%- if p.featured_media -%}
                    {{ p.featured_media | image_url: width: 200 | image_tag: loading: 'lazy', sizes: '80px', alt: '' }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </span>
                <span class="tw-min-w-0">
                  <span class="tw-block tw-font-heading tw-text-lg tw-leading-tight">{{ p.title | default: 'Choose a product' }}</span>
                  {%- if p -%}<span class="tw-block tw-mt-1">{% render 'price', product: p %}</span>{%- endif -%}
                </span>
              </a>
            {%- endfor -%}
          {%- endif -%}
          {%- if st.button_label != blank -%}
            <a href="{{ st.link | default: '#' }}" class="btn tw-mt-3 tw-self-start">{{ st.button_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop the look",
  "class": "section-shop-the-look",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Shop the look"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Styled together"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "default": "portrait",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        },
        {
          "value": "natural",
          "label": "Natural (no cropping)"
        }
      ]
    },
    {
      "type": "header",
      "content": "Hotspots"
    },
    {
      "type": "select",
      "id": "hotspot_action",
      "label": "When a dot is clicked",
      "default": "popup",
      "options": [
        {
          "value": "popup",
          "label": "Show product card on the image"
        },
        {
          "value": "list",
          "label": "Highlight product in the list"
        }
      ]
    },
    {
      "type": "select",
      "id": "hotspot_style",
      "label": "Dot style",
      "default": "dot",
      "options": [
        {
          "value": "dot",
          "label": "Pulsing dot"
        },
        {
          "value": "number",
          "label": "Number"
        },
        {
          "value": "plus",
          "label": "Plus icon"
        }
      ]
    },
    {
      "type": "color",
      "id": "hotspot_color",
      "label": "Dot color",
      "info": "Leave empty for white."
    },
    {
      "type": "checkbox",
      "id": "popup_add_to_cart",
      "label": "Show Add to cart in product card",
      "default": true
    },
    {
      "type": "header",
      "content": "Product list"
    },
    {
      "type": "checkbox",
      "id": "show_product_list",
      "label": "Show product list next to image",
      "default": true
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "alt_bg",
      "label": "Use alternate background",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Product hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "x",
          "label": "Horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "y",
          "label": "Vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop the look",
      "blocks": [
        {
          "type": "hotspot",
          "settings": {
            "x": 35,
            "y": 40
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "x": 65,
            "y": 65
          }
        }
      ]
    }
  ]
}
{% endschema %}
