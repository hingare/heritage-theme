{%- liquid
  assign h_class = 'tw-items-start tw-text-left'
  if section.settings.text_align == 'center'
    assign h_class = 'tw-items-center tw-text-center'
  elsif section.settings.text_align == 'right'
    assign h_class = 'tw-items-end tw-text-right'
  endif
  assign v_class = 'tw-justify-center'
  if section.settings.text_position == 'top'
    assign v_class = 'tw-justify-start'
  elsif section.settings.text_position == 'bottom'
    assign v_class = 'tw-justify-end'
  endif
-%}
<div class="image-banner image-banner--{{ section.settings.height }}{% if section.settings.scroll_effect != 'none' %} image-banner--{{ section.settings.scroll_effect }}{% endif %}" style="color: {{ section.settings.text_color }}; --overlay-opacity: {{ section.settings.overlay | divided_by: 100.0 }};" data-image-banner>
  <div class="image-banner__media" data-image-banner-media>
    {%- if section.settings.image != blank -%}
      {%- liquid
        assign banner_alt = section.settings.image.alt | escape
        assign focal = 'object-position: ' | append: section.settings.image.presentation.focal_point
        assign banner_loading = 'lazy'
        if section.index == 1
          assign banner_loading = 'eager'
        endif
      -%}
      {{ section.settings.image | image_url: width: 2800 | image_tag: loading: banner_loading, fetchpriority: banner_loading | replace: 'eager', 'high' | replace: 'lazy', 'auto', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2800', alt: banner_alt, style: focal, class: 'image-banner__img' }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg image-banner__img' }}
    {%- endif -%}
    {%- if section.settings.image_mobile != blank -%}
      {%- assign banner_m_alt = section.settings.image_mobile.alt | escape -%}
      {{ section.settings.image_mobile | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '100vw', widths: '550, 750, 1100', alt: banner_m_alt, class: 'image-banner__img image-banner__img--mobile' }}
    {%- endif -%}
  </div>
  <div class="image-banner__overlay"></div>

  <div class="page-width image-banner__content tw-flex tw-flex-col {{ v_class }} {{ h_class }}">
    <div class="tw-max-w-2xl image-banner__text">
      {%- if section.settings.subheading != blank -%}<span class="subheading">{{ section.settings.subheading }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="image-banner__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte tw-text-lg">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
        <div class="tw-flex tw-flex-wrap tw-gap-3 tw-mt-8{% if section.settings.text_align == 'center' %} tw-justify-center{% elsif section.settings.text_align == 'right' %} tw-justify-end{% endif %}">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.link | default: '#' }}" class="btn btn--light">{{ section.settings.button_label }}</a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a href="{{ section.settings.link_2 | default: '#' }}" class="btn btn--secondary" style="color: inherit;">{{ section.settings.button_label_2 }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image banner",
  "class": "section-image-banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "2800 x 1400px recommended" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
    { "type": "select", "id": "height", "label": "Height", "default": "large", "options": [
      { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }, { "value": "full", "label": "Full screen" }
    ] },
    { "type": "select", "id": "scroll_effect", "label": "Scroll effect", "default": "zoom", "options": [
      { "value": "none", "label": "None" }, { "value": "zoom", "label": "Zoom out" }, { "value": "parallax", "label": "Parallax" }
    ] },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "New season" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made to be carried for decades" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "text", "id": "button_label_2", "label": "Second button label" },
    { "type": "url", "id": "link_2", "label": "Second button link" },
    { "type": "select", "id": "text_position", "label": "Vertical text position", "default": "bottom", "options": [
      { "value": "top", "label": "Top" }, { "value": "center", "label": "Middle" }, { "value": "bottom", "label": "Bottom" }
    ] },
    { "type": "select", "id": "text_align", "label": "Horizontal text position", "default": "left", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }
    ] },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "range", "id": "overlay", "label": "Image overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30 }
  ],
  "presets": [ { "name": "Image banner" } ]
}
{% endschema %}
