{{ 'video-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'video-sections.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign scheme = s.color_scheme | default: 'scheme-1'
-%}
<div class="section color-{{ scheme }} vreels-section{% if s.alt_bg %} section--alt{% endif %}">
  <video-reels class="vreels page-width vreels--{{ s.card_size }}" data-play="{{ s.play_mode }}">
    {%- if s.heading != blank or s.subheading != blank -%}
      <div class="vreels__head">
        <div>
          {%- if s.subheading != blank -%}<span class="subheading">{{ s.subheading }}</span>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="vreels__heading h2">{{ s.heading }}</h2>{%- endif -%}
        </div>
        <div class="vreels__arrows">
          <button type="button" class="vreels__arrow" data-vr-scroll="-1" aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
          <button type="button" class="vreels__arrow" data-vr-scroll="1" aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
        </div>
      </div>
    {%- endif -%}

    <div class="vreels__track" data-vr-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign src = ''
          if b.video != blank
            assign src = b.video.sources | where: 'mime_type', 'video/mp4' | map: 'url' | first
            if src == blank
              assign src = b.video.sources.first.url
            endif
          elsif b.video_mp4_url != blank
            assign src = b.video_mp4_url
          endif
          assign p = b.product
        -%}
        <article class="vreel" data-vr-item data-src="{{ src }}" {{ block.shopify_attributes }}>
          <button type="button" class="vreel__open" data-vr-open="{{ forloop.index0 }}" aria-label="{{ 'video.play' | t }}{% if b.title != blank %}: {{ b.title | escape }}{% endif %}">
            <span class="vreel__media">
              {%- if b.image != blank -%}
                {{ b.image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 300px, 60vw', widths: '360, 540, 700', alt: '', class: 'vreel__poster' }}
              {%- elsif b.video != blank and b.video.preview_image -%}
                {{ b.video.preview_image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 300px, 60vw', widths: '360, 540, 700', alt: '', class: 'vreel__poster' }}
              {%- elsif p != blank and p.featured_image -%}
                {{ p.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 300px, 60vw', alt: '', class: 'vreel__poster' }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg vreel__poster' }}
              {%- endif -%}
              {%- if src != blank -%}
                <video class="vreel__video" muted loop playsinline preload="none" aria-hidden="true"></video>
              {%- endif -%}
              <span class="vreel__play">{% render 'icon', name: 'play' %}</span>
              {%- if b.title != blank -%}<span class="vreel__caption">{{ b.title }}</span>{%- endif -%}
            </span>
          </button>
          {%- if p != blank -%}
            <a class="vreel__product" href="{{ p.url }}">
              {%- if p.featured_image -%}
                {{ p.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', sizes: '48px', alt: '', class: 'vreel__product-img' }}
              {%- endif -%}
              <span class="vreel__product-info">
                <span class="vreel__product-title">{{ p.title }}</span>
                <span class="vreel__product-price">{{ p.price | money }}</span>
              </span>
            </a>
          {%- endif -%}
          <template data-vr-product>
            {%- if p != blank -%}
              <div class="vreels-modal__product">
                {%- if p.featured_image -%}
                  {{ p.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', sizes: '64px', alt: '', class: 'vreels-modal__product-img' }}
                {%- endif -%}
                <div class="vreels-modal__product-info">
                  <a href="{{ p.url }}" class="vreels-modal__product-title">{{ p.title }}</a>
                  <span>{{ p.price | money }}</span>
                </div>
                {%- if p.available and p.has_only_default_variant -%}
                  <form action="{{ routes.cart_add_url }}" method="post" data-product-form data-ajax="true" class="vreels-modal__form">
                    <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit" class="btn btn--small">{{ 'products.product.add_to_cart' | t }}</button>
                  </form>
                {%- else -%}
                  <a href="{{ p.url }}" class="btn btn--small">{{ 'video.shop' | t }}</a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </template>
        </article>
      {%- endfor -%}
    </div>

    <div class="vreels-modal" data-vr-modal hidden>
      <div class="vreels-modal__backdrop" data-vr-close></div>
      <div class="vreels-modal__box" role="dialog" aria-modal="true" aria-label="{{ s.heading | default: 'Video' | escape }}">
        <button type="button" class="vreels-modal__close" data-vr-close aria-label="{{ 'video.close' | t }}">{% render 'icon', name: 'close' %}</button>
        <button type="button" class="vreels-modal__nav vreels-modal__nav--prev" data-vr-step="-1" aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
        <div class="vreels-modal__stage">
          <video class="vreels-modal__video" playsinline loop data-vr-modal-video></video>
          <div class="vreels-modal__progress" aria-hidden="true"><i data-vr-progress></i></div>
          <button type="button" class="vreels-modal__sound" data-vr-sound aria-pressed="true" aria-label="{{ 'video.sound_off' | t }}" data-label-on="{{ 'video.sound_on' | t }}" data-label-off="{{ 'video.sound_off' | t }}">
            <span class="vs-ico vs-ico--muted">{% render 'icon', name: 'volume-off' %}</span><span class="vs-ico vs-ico--unmuted">{% render 'icon', name: 'volume' %}</span>
          </button>
          <div class="vreels-modal__caption" data-vr-caption></div>
          <div data-vr-modal-product></div>
        </div>
        <button type="button" class="vreels-modal__nav vreels-modal__nav--next" data-vr-step="1" aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
      </div>
    </div>
  </video-reels>
</div>

{% schema %}
{
  "name": "Video reels",
  "tag": "section",
  "class": "section-video-reels",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Watch & shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See it in action" },
    { "type": "select", "id": "card_size", "label": "Card size", "default": "medium", "options": [
      { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }
    ] },
    { "type": "select", "id": "play_mode", "label": "Preview playback", "default": "inview", "options": [
      { "value": "inview", "label": "Play muted when on screen" },
      { "value": "hover", "label": "Play on hover (desktop)" },
      { "value": "none", "label": "Show image only" }
    ], "info": "Clicking a card always opens the video with sound." },
    { "type": "checkbox", "id": "alt_bg", "label": "Use alternate background", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Shopify video", "info": "Vertical 9:16 videos look best." },
        { "type": "url", "id": "video_mp4_url", "label": "Or video link (MP4)" },
        { "type": "image_picker", "id": "image", "label": "Cover image", "info": "Optional. The video's first frame is used if empty." },
        { "type": "text", "id": "title", "label": "Caption", "default": "Everyday carry" },
        { "type": "product", "id": "product", "label": "Tagged product", "info": "Shown under the video with an Add to cart button." }
      ]
    }
  ],
  "presets": [
    { "name": "Video reels", "blocks": [ { "type": "video" }, { "type": "video" }, { "type": "video" }, { "type": "video" }, { "type": "video" } ] }
  ]
}
{% endschema %}
