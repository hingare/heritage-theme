{%- assign collection = section.settings.collection -%}
<div class="section color-{{ section.settings.color_scheme }}{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header{% if section.settings.center_heading %} section-header--center{% endif %}">
        <div>
          {%- if section.settings.subheading != blank -%}<span class="subheading">{{ section.settings.subheading }}</span>{%- endif -%}
          <h2>{{ section.settings.heading }}</h2>
        </div>
        {%- if section.settings.view_all and collection != blank -%}
          <a href="{{ collection.url }}" class="section-header__link">{{ 'general.view_all' | t }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="grid{% if section.settings.mobile_scroll %} grid--scroll-mobile{% endif %}" style="--cols: {{ section.settings.columns }}; --cols-tablet: {{ section.settings.columns | at_most: 3 }};">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.columns) -%}
          <div class="product-card">
            <div class="media media--product">{{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="product-card__info"><span class="product-card__title">Product title</span><div class="price">$0.00</div></div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured collection",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "checkbox",
      "id": "center_heading",
      "label": "Center heading",
      "default": false
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Products per row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "mobile_scroll",
      "label": "Swipe on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "view_all",
      "label": "Show view all link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "alt_bg",
      "label": "Use alternate background",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
