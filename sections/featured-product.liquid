{%- liquid
  assign product = section.settings.product
  assign s = section.settings
-%}
<div class="section color-{{ s.color_scheme }}{% if s.alt_bg %} section--alt{% endif %}" style="padding-top: {{ s.padding_top }}px; padding-bottom: {{ s.padding_bottom }}px;">
  {%- if product != blank -%}
    {%- assign current_variant = product.selected_or_first_available_variant -%}
    <div id="Product-{{ section.id }}" class="page-width product-wrapper featured-product" data-product-root data-url="{{ product.url }}" data-section-id="{{ section.id }}" data-update-url="false">
      <div class="product{% if s.media_size == 'small' %} product--media-small{% endif %}{% if s.media_position == 'right' %} product--media-right{% endif %}" style="padding-top: 0; padding-bottom: 0;">
        <div class="product__media-wrapper">
          {%- if s.show_badges -%}
            <div class="product-card__badges product-gallery__badges" data-update="badges">
              {%- if current_variant.available == false and settings.badge_show_sold_out -%}
                <span class="badge badge--sold-out">{{ 'products.product.sold_out' | t }}</span>
              {%- elsif current_variant.compare_at_price > current_variant.price -%}
                {%- assign gb_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
                <span class="badge badge--sale">{% if settings.sale_badge_percent %}-{{ gb_pct }}%{% else %}{{ 'products.product.on_sale' | t }}{% endif %}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
          {% render 'product-gallery', product: product, section: section, layout: s.gallery_layout, zoom: s.enable_zoom %}
        </div>
        <div class="product__info">
          {%- if s.subheading != blank -%}<span class="subheading">{{ s.subheading }}</span>{%- endif -%}
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == '@app' -%}
                {% render block %}
              {%- else -%}
                {% render 'product-info-block', block: block, product: product, current_variant: current_variant, section: section, title_tag: 'h2', link_title: s.link_title %}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <h2 class="product__title">{{ product.title }}</h2>
            <div data-update="price">{% render 'price', product: product, variant: current_variant, large: true, show_save: true %}</div>
            {% render 'product-variant-picker', product: product, section: section, picker_type: 'button', use_swatches: true %}
            {% render 'product-buy-buttons', product: product, section: section, show_quantity: true, show_dynamic: s.show_dynamic %}
            {%- if s.show_description and product.description != blank -%}
              <div class="product__description rte">{{ product.description | strip_html | truncatewords: 50 }}</div>
            {%- endif -%}
            <a href="{{ product.url }}" class="link-underline" style="align-self: flex-start;">{{ 'products.product.view_details' | t }}</a>
          {%- endif -%}
        </div>
      </div>
      <script type="application/json" data-product-json>{{ product | json }}</script>
    </div>
    {%- if s.enable_zoom -%}
      <div class="lightbox" data-lightbox>
        <button type="button" class="lightbox__close" data-lightbox-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
        <div data-lightbox-body></div>
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="page-width">
      <div class="product" style="padding: 0;">
        <div class="media media--product">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        <div class="product__info">
          {%- if s.subheading != blank -%}<span class="subheading">{{ s.subheading }}</span>{%- endif -%}
          <h2>Your product's name</h2><div class="price price--large">$19.99</div>
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

