<div class="page-width cart-page" data-cart-page data-section-id="{{ section.id }}" style="padding-bottom: 4rem;">
  <div class="page-header"><h1>{{ 'cart.title' | t }}</h1></div>
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <div class="cart-page__layout">
        <div>
          {% render 'free-shipping-bar' %}
          {% render 'cart-items' %}
        </div>
        <div class="cart-page__summary">
          {%- if settings.cart_notes_enabled -%}
            <div class="field">
              <label for="CartNote">{{ 'cart.note' | t }}</label>
              <textarea id="CartNote" name="note" class="textarea" data-cart-note>{{ cart.note }}</textarea>
            </div>
          {%- endif -%}
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="cart-subtotal" style="font-size: 0.9rem;"><span>{{ discount.title }}</span><span>-{{ discount.total_allocated_amount | money }}</span></div>
          {%- endfor -%}
          <div class="cart-subtotal"><span>{{ 'cart.subtotal' | t }}</span><span>{% if settings.show_currency_code %}{{ cart.total_price | money_with_currency }}{% else %}{{ cart.total_price | money }}{% endif %}</span></div>
          <p class="cart-taxes">{{ 'cart.taxes' | t }}</p>
          {%- if settings.cart_terms_text != blank -%}
            <label class="cart-terms">
              <input type="checkbox" data-cart-terms data-message="{{ 'cart.terms_required' | t | escape }}">
              <span>{{ settings.cart_terms_text }}</span>
            </label>
          {%- endif -%}
          <button type="submit" name="checkout" class="btn btn--full">{% render 'icon', name: 'lock' %} {{ 'cart.checkout' | t }}</button>
          {%- if additional_checkout_buttons -%}
            <div style="margin-top: 0.75rem;">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </div>
      </div>
    </form>
  {%- else -%}
    <div class="cart-empty">
      <p>{{ 'cart.empty' | t }}</p>
      <a href="{{ settings.cart_empty_link | default: routes.all_products_collection_url }}" class="btn">{{ 'general.continue_shopping' | t }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart page",
  "settings": []
}
{% endschema %}
