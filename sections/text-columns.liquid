<div class="section color-{{ section.settings.color_scheme }}{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header section-header--center"><h2>{{ section.settings.heading }}</h2></div>
    {%- endif -%}
    <div class="text-columns" style="--cols: {{ section.blocks.size | at_least: 1 | at_most: 4 }}; --align: {{ section.settings.align }};">
      {%- for block in section.blocks -%}
        <div class="text-column" data-reveal {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="text-column__image media media--{{ section.settings.image_ratio }}">
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 100vw', widths: '300, 600, 900' }}
            </div>
          {%- elsif block.settings.icon != 'none' -%}
            <div class="text-column__icon"{% if section.settings.align == 'left' %} style="margin-left: 0;"{% endif %}>{% render 'icon', name: block.settings.icon %}</div>
          {%- endif -%}
          {%- if block.settings.title != blank -%}<h3>{{ block.settings.title }}</h3>{%- endif -%}
          <div class="rte">{{ block.settings.text }}</div>
          {%- if block.settings.link_label != blank -%}
            <p style="margin-top: 0.75rem;"><a href="{{ block.settings.link | default: '#' }}" class="link-underline">{{ block.settings.link_label }}</a></p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Text columns with icons",
  "class": "section-text-columns",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "default": "landscape",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "alt_bg",
      "label": "Use alternate background",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "return",
              "label": "Return"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "lock",
              "label": "Lock"
            },
            {
              "value": "leather",
              "label": "Leather"
            },
            {
              "value": "hand",
              "label": "Handmade"
            },
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "chat",
              "label": "Chat"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "heart",
              "label": "Heart"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Replaces the icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Free shipping"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>On all orders over $150.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text columns with icons",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}
