<div class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width">
    <div class="section-header section-header--center">
      {%- if section.settings.subheading != blank -%}<span class="subheading">{{ section.settings.subheading }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    </div>

    <ol class="timeline">
      {%- for block in section.blocks -%}
        <li class="timeline__item" data-reveal {{ block.shopify_attributes }}>
          <span class="timeline__marker" aria-hidden="true"></span>
          {%- if block.settings.image != blank -%}
            {%- assign tl_alt = block.settings.image.alt | escape -%}
            <div class="media media--landscape tw-mb-5">
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 85vw', widths: '450, 700, 900', alt: tl_alt }}
            </div>
          {%- endif -%}
          {%- if block.settings.label != blank -%}<span class="timeline__label">{{ block.settings.label }}</span>{%- endif -%}
          {%- if block.settings.heading != blank -%}<h3 class="h4 tw-mt-1">{{ block.settings.heading }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<div class="rte tw-text-[0.95rem]">{{ block.settings.text }}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% schema %}
{
  "name": "Timeline",
  "class": "section-timeline",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Our journey" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From hide to heirloom" },
    { "type": "checkbox", "id": "alt_bg", "label": "Use alternate background", "default": false }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Label", "default": "Step", "info": "A year, date or step number" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Milestone" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe this step of the story.</p>" }
      ]
    }
  ],
  "presets": [
    { "name": "Timeline", "blocks": [
      { "type": "step", "settings": { "label": "01", "heading": "Selecting the leather" } },
      { "type": "step", "settings": { "label": "02", "heading": "Cutting by hand" } },
      { "type": "step", "settings": { "label": "03", "heading": "Stitching and finishing" } }
    ] }
  ]
}
{% endschema %}
