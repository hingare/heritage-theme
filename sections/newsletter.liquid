<div class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width">
    <div class="newsletter" data-reveal>
      {%- if section.settings.subheading != blank -%}<span class="subheading">{{ section.settings.subheading }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      {% render 'newsletter-form', form_id: section.id %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Subscribe to our emails" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Be the first to know about new collections and exclusive offers.</p>" },
    { "type": "checkbox", "id": "alt_bg", "label": "Use alternate background", "default": true }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}
