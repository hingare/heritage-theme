{%- if section.blocks.size > 0 -%}
  <div class="announcement-bar" role="region" aria-label="Announcement" {{ section.shopify_attributes }}>
    <div class="page-width announcement-bar__inner">
      {%- if section.settings.show_social -%}
        <div class="announcement-bar__side">{% render 'social-icons' %}</div>
      {%- endif -%}
      <div class="announcement-bar__slider" data-announcement-slider data-speed="{{ section.settings.speed }}">
        {%- for block in section.blocks -%}
          <div class="announcement-bar__message{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {%- else -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      {%- if section.settings.right_text != blank -%}
        <div class="announcement-bar__side">{{ section.settings.right_text }}</div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "max_blocks": 6,
  "settings": [
    { "type": "range", "id": "speed", "label": "Change message every", "min": 3, "max": 15, "step": 1, "unit": "s", "default": 5 },
    { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": false },
    { "type": "inline_richtext", "id": "right_text", "label": "Right side text" }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over $150" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Announcement bar", "blocks": [ { "type": "announcement" } ] }
  ]
}
{% endschema %}
