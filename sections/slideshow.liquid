<div class="slideshow slideshow--{{ section.settings.height }}" data-slideshow data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.speed }}" role="region" aria-roledescription="carousel" aria-label="{{ section.settings.accessibility_label | escape }}">
  <div class="slideshow__track">
    {%- for block in section.blocks -%}
      {%- liquid
        assign h_class = ''
        if block.settings.text_align == 'center'
          assign h_class = 'slide__content--h-center'
        elsif block.settings.text_align == 'right'
          assign h_class = 'slide__content--h-right'
        endif
      -%}
      <div class="slide" style="--overlay-opacity: {{ block.settings.overlay | divided_by: 100.0 }}; color: {{ block.settings.text_color }};" {{ block.shopify_attributes }}>
        <div class="slide__media{% if block.settings.image_mobile != blank %} slide__media--has-mobile{% endif %}">
          <div class="slide__media--desktop" style="position:absolute;inset:0;">
            {%- if block.settings.image != blank -%}
              {%- liquid
                assign loading = 'lazy'
                assign slide_alt = block.settings.image.alt | escape
                assign focal = 'object-position: ' | append: block.settings.image.presentation.focal_point
                assign priority = 'auto'
                if forloop.first and section.index <= 2
                  assign loading = 'eager'
                  if section.index == 1
                    assign priority = 'high'
                  endif
                endif
              -%}
              {{ block.settings.image | image_url: width: 2400 | image_tag: loading: loading, fetchpriority: priority, sizes: '100vw', widths: '750, 1100, 1500, 1900, 2400', alt: slide_alt, style: focal }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          {%- if block.settings.image_mobile != blank -%}
            <div class="slide__media--mobile" style="position:absolute;inset:0;">
              {{ block.settings.image_mobile | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '100vw', widths: '550, 750, 1100', alt: block.settings.image_mobile.alt | escape }}
            </div>
          {%- endif -%}
        </div>
        <div class="slide__overlay"></div>
        {%- if block.settings.link != blank and block.settings.button_label == blank -%}
          <a href="{{ block.settings.link }}" class="promo-grid__link-cover" aria-label="{{ block.settings.heading | escape }}"></a>
        {%- endif -%}
        <div class="page-width slide__content slide__content--{{ block.settings.text_position }} {{ h_class }}">
          <div class="slide__text">
            {%- if block.settings.subheading != blank -%}<span class="subheading">{{ block.settings.subheading }}</span>{%- endif -%}
            {%- if block.settings.heading != blank -%}<h2 class="slide__heading">{{ block.settings.heading }}</h2>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="slide__subheading">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.button_label != blank or block.settings.button_label_2 != blank -%}
              <div class="slide__buttons">
                {%- if block.settings.button_label != blank -%}
                  <a href="{{ block.settings.link | default: '#' }}" class="btn btn--light">{{ block.settings.button_label }}</a>
                {%- endif -%}
                {%- if block.settings.button_label_2 != blank -%}
                  <a href="{{ block.settings.link_2 | default: '#' }}" class="btn btn--secondary" style="color: inherit;">{{ block.settings.button_label_2 }}</a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <button type="button" class="slideshow__arrow slideshow__arrow--prev" data-slide-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
    <button type="button" class="slideshow__arrow slideshow__arrow--next" data-slide-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
    <div class="slideshow__controls">
      {%- for block in section.blocks -%}
        <button type="button" class="slideshow__dot" data-slide-dot aria-label="{{ 'accessibility.slide' | t: number: forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Slideshow",
  "class": "section-slideshow",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "accessibility_label", "label": "Slideshow description", "default": "Featured collections" },
    { "type": "select", "id": "height", "label": "Height", "default": "medium", "options": [
      { "value": "small", "label": "Small" },
      { "value": "medium", "label": "Medium" },
      { "value": "large", "label": "Large" },
      { "value": "full", "label": "Full screen" }
    ] },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "speed", "label": "Change slides every", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 6 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "2400 x 1200px recommended" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Optional, 1100 x 1400px recommended" },
        { "type": "text", "id": "subheading", "label": "Subheading", "default": "New collection" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Crafted to last" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell customers what makes this collection special.</p>" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Button link" },
        { "type": "text", "id": "button_label_2", "label": "Second button label" },
        { "type": "url", "id": "link_2", "label": "Second button link" },
        { "type": "select", "id": "text_position", "label": "Vertical text position", "default": "center", "options": [
          { "value": "top", "label": "Top" }, { "value": "center", "label": "Middle" }, { "value": "bottom", "label": "Bottom" }
        ] },
        { "type": "select", "id": "text_align", "label": "Horizontal text position", "default": "left", "options": [
          { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }
        ] },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
        { "type": "range", "id": "overlay", "label": "Image overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 25 }
      ]
    }
  ],
  "presets": [
    { "name": "Slideshow", "blocks": [ { "type": "slide" }, { "type": "slide" } ] }
  ]
}
{% endschema %}
