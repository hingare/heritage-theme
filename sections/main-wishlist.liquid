<div class="section color-{{ section.settings.color_scheme }}">
  <div class="page-width" data-wishlist-page>
    <div class="section-header section-header--center">
      <h1 class="h2">{{ section.settings.heading | default: page.title }}</h1>
    </div>
    {%- if page.content != blank -%}<div class="rte tw-text-center tw-mb-10">{{ page.content }}</div>{%- endif -%}
    <div class="grid" style="--cols: {{ section.settings.columns }};" data-wishlist-grid></div>
    <div class="tw-text-center tw-py-10" data-wishlist-empty hidden>
      <p>{{ 'wishlist.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn tw-mt-4">{{ 'general.continue_shopping' | t }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Wishlist",
  "class": "section-main-wishlist",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the page title"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
