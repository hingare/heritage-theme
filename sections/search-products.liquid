{%- comment -%}
  Product data for the search panel, fetched with the Section Rendering API:
  /collections/<handle>?sort_by=best-selling&section_id=search-products
{%- endcomment -%}
<script type="application/json" data-search-products>
  [
    {%- for product in collection.products limit: 8 -%}
      {%- liquid
        assign image = product.featured_media.preview_image
        assign compare = product.compare_at_price | default: 0
      -%}
      {
        "id": {{ product.id | json }},
        "title": {{ product.title | json }},
        "url": {{ product.url | json }},
        "image": {% if image %}{{ image | image_url: width: 400 | json }}{% else %}""{% endif %},
        "alt": {{ image.alt | default: product.title | json }},
        "price": {{ product.price | json }},
        "compareAt": {{ compare | json }},
        "available": {{ product.available | json }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
</script>

{% schema %}
{
  "name": "Search products",
  "settings": []
}
{% endschema %}
