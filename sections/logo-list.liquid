<div class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header section-header--center"><h2 class="h3">{{ section.settings.heading }}</h2></div>
    {%- endif -%}
    <div class="logo-list">
      {%- for block in section.blocks -%}
        <a {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} class="logo-list__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', sizes: '140px', alt: block.settings.image.alt | escape }}
          {%- else -%}
            {{ 'logo' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Logo list",
  "class": "section-logo-list",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "As seen in" },
    { "type": "checkbox", "id": "alt_bg", "label": "Use alternate background", "default": false }
  ],
  "blocks": [
    { "type": "logo", "name": "Logo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [ { "name": "Logo list", "blocks": [ { "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" } ] } ]
}
{% endschema %}
