{%- liquid
  assign show_filters = false
  if section.settings.enable_filtering and collection.filters.size > 0
    assign show_filters = true
  endif
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign clear_url = collection.url | append: '?sort_by=' | append: sort_by
  assign active_count = 0
  for filter in collection.filters
    assign active_count = active_count | plus: filter.active_values.size
    if filter.type == 'price_range' and filter.min_value.value or filter.max_value.value
      assign active_count = active_count | plus: 1
    endif
  endfor
  assign filter_drawer = false
  if section.settings.filter_layout == 'drawer'
    assign filter_drawer = true
  endif
  assign hero_class = 'collection-hero--' | append: section.settings.hero_height | append: ' collection-hero--' | append: section.settings.hero_align
  assign sub_menu = section.settings.subcollections_menu
  if sub_menu == blank and section.settings.show_subcollections
    assign sub_menu = linklists[collection.handle]
  endif
-%}

{%- if section.settings.show_header -%}
  {%- if section.settings.show_image and collection.image -%}
    <div class="collection-hero {{ hero_class }}" style="--hero-overlay: {{ section.settings.hero_overlay | divided_by: 100.0 }};">
      <div class="collection-hero__media">
        {{ collection.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2400', alt: collection.title }}
      </div>
      <div class="page-width collection-hero__content">
        <h1>{{ collection.title }}</h1>
        {%- if section.settings.show_description and collection.description != blank -%}<div class="rte">{{ collection.description }}</div>{%- endif -%}
      </div>
    </div>
  {%- else -%}
    <div class="page-width collection-header">
      <h1>{{ collection.title }}</h1>
      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="collection-header__description rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endif -%}

{%- if section.settings.show_subcollections and sub_menu.links.size > 0 -%}
  <nav class="page-width subcollections" aria-label="{{ 'collections.subcollections' | t }}">
    <div class="tab-row subcollections__row">
      {%- for link in sub_menu.links -%}
        <a href="{{ link.url }}" class="subcollections__pill{% if link.active %} is-active{% endif %}">{{ link.title }}</a>
      {%- endfor -%}
    </div>
  </nav>
{%- endif -%}

<div class="page-width{% if filter_drawer %} collection--filter-drawer{% endif %}" data-collection-container data-section-id="{{ section.id }}" style="padding-bottom: 4rem;">
  {%- paginate collection.products by section.settings.per_page -%}
    <div class="collection-toolbar">
      <div class="collection-toolbar__left" style="display:flex;align-items:center;gap:1.25rem;">
        {%- if show_filters -%}
          <button type="button" class="collection-toolbar__filter-btn collection-toolbar__filter-btn--mobile" data-open="FilterDrawer">
            {% render 'icon', name: 'filter' %}<span>{{ 'collections.filter' | t }}</span>
            <span class="collection-toolbar__filter-count" data-filter-count{% if active_count == 0 %} hidden{% endif %}>{{ active_count }}</span>
          </button>
        {%- endif -%}
        <span class="collection-toolbar__count" data-collection-count>{{ 'collections.products_count' | t: count: collection.products_count }}</span>
      </div>
      <div class="collection-toolbar__right">
        {%- if section.settings.enable_sorting -%}
          <label for="SortBy" class="visually-hidden">{{ 'collections.sort_by' | t }}</label>
          <select id="SortBy" class="select" data-sort-select>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        {%- endif -%}
        {%- if section.settings.enable_grid_toggle -%}
          <div class="grid-toggle" data-default-cols="{{ section.settings.columns }}">
            <button type="button" data-grid-cols="2" aria-label="2">{% render 'icon', name: 'grid-2' %}</button>
            <button type="button" data-grid-cols="{{ section.settings.columns }}" aria-label="{{ section.settings.columns }}">{% render 'icon', name: 'grid-3' %}</button>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="collection-layout{% unless show_filters %} collection-layout--no-sidebar{% endunless %}">
      {%- if show_filters -%}
        <aside id="FilterDrawer" class="collection-sidebar drawer drawer--left" aria-hidden="true" aria-label="{{ 'collections.filter' | t }}">
          <div class="drawer__header">
            <span class="drawer__title h3">{{ 'collections.filter' | t }}</span>
            <button type="button" class="drawer__close" data-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
          </div>
          <div class="drawer__body">
            {% render 'facets', results: collection, collapsed: section.settings.filters_collapsed %}
          </div>
          <div class="drawer__footer">
            <button type="button" class="btn btn--full" data-close>{{ 'collections.apply' | t }}</button>
          </div>
        </aside>
      {%- endif -%}

      <div>
        <div data-active-facets>{% render 'active-facets', results: collection, clear_url: clear_url %}</div>
        <div class="collection-grid" data-collection-results>
          {%- if collection.products.size > 0 -%}
            <div class="grid" style="--cols: {{ section.settings.columns }}; --cols-tablet: 3; --cols-mobile: {{ section.settings.columns_mobile }};">
              {%- for product in collection.products -%}
                {%- liquid
                  assign lazy = true
                  if forloop.index <= 4
                    assign lazy = false
                  endif
                -%}
                {%- if paginate.current_page == 1 and active_count == 0 -%}
                  {%- assign card_index = forloop.index -%}
                  {%- for block in section.blocks -%}
                    {%- if block.settings.position == card_index -%}
                      {%- render 'collection-promo', block: block -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
                {% render 'product-card', product: product, lazy: lazy %}
              {%- endfor -%}
            </div>
            {%- if section.settings.pagination_type == 'numbers' or paginate.pages <= 1 -%}
              {% render 'pagination', paginate: paginate %}
            {%- else -%}
              {%- liquid
                assign shown = paginate.current_offset | plus: collection.products.size
              -%}
              <div class="load-more" data-load-more{% if section.settings.pagination_type == 'infinite' %} data-infinite{% endif %}>
                <p class="load-more__status" data-load-more-status>{{ 'collections.showing' | t: shown: shown, total: paginate.items }}</p>
                <div class="load-more__bar" aria-hidden="true"><span style="width: {{ shown | times: 100 | divided_by: paginate.items }}%;" data-load-more-bar></span></div>
                {%- if paginate.next -%}
                  <a href="{{ paginate.next.url }}" class="btn btn--secondary load-more__btn" data-load-more-btn>{{ 'collections.load_more' | t }}</a>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- else -%}
            <div class="collection-empty">
              <p>{{ 'collections.empty' | t }}</p>
              <a href="{{ clear_url }}" class="btn btn--secondary" data-facet-remove>{{ 'collections.clear_all' | t }}</a>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection page",
  "class": "section-main-collection",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "checkbox", "id": "show_header", "label": "Show collection title", "default": true },
    { "type": "checkbox", "id": "show_image", "label": "Show collection image as banner", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true },
    { "type": "select", "id": "hero_height", "label": "Banner height", "default": "medium", "options": [ { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] },
    { "type": "select", "id": "hero_align", "label": "Banner text position", "default": "left", "options": [ { "value": "left", "label": "Bottom left" }, { "value": "center", "label": "Center" } ] },
    { "type": "range", "id": "hero_overlay", "label": "Banner overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 },
    { "type": "header", "content": "Subcollections" },
    { "type": "checkbox", "id": "show_subcollections", "label": "Show subcollection links", "default": true, "info": "Uses a menu with the same handle as the collection (e.g. a menu called \"womens-bags\"), or the menu picked below." },
    { "type": "link_list", "id": "subcollections_menu", "label": "Menu" },
    { "type": "header", "content": "Products" },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "select", "id": "pagination_type", "label": "Pagination", "default": "load_more", "options": [ { "value": "numbers", "label": "Page numbers" }, { "value": "load_more", "label": "Load more button" }, { "value": "infinite", "label": "Infinite scroll" } ] },
    { "type": "range", "id": "columns", "label": "Products per row (desktop)", "min": 2, "max": 5, "step": 1, "default": 3 },
    { "type": "select", "id": "columns_mobile", "label": "Products per row (mobile)", "default": "2", "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ] },
    { "type": "header", "content": "Filtering and sorting" },
    { "type": "checkbox", "id": "enable_filtering", "label": "Enable filtering", "default": true, "info": "Customize filters with the Search & Discovery app" },
    { "type": "select", "id": "filter_layout", "label": "Filter layout (desktop)", "default": "sidebar", "options": [ { "value": "sidebar", "label": "Sidebar" }, { "value": "drawer", "label": "Drawer" } ], "info": "Filters always open in a drawer on mobile." },
    { "type": "checkbox", "id": "filters_collapsed", "label": "Collapse filter groups", "default": false },
    { "type": "checkbox", "id": "enable_sorting", "label": "Enable sorting", "default": true },
    { "type": "checkbox", "id": "enable_grid_toggle", "label": "Show grid size toggle", "default": true }
  ],
  "blocks": [
    { "type": "promo", "name": "Promotion tile", "settings": [
      { "type": "paragraph", "content": "Shows inside the product grid on the first page, when no filters are used." },
      { "type": "range", "id": "position", "label": "Position in grid", "min": 1, "max": 24, "step": 1, "default": 3 },
      { "type": "select", "id": "span", "label": "Width", "default": "1", "options": [ { "value": "1", "label": "1 product" }, { "value": "2", "label": "2 products" } ] },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "subheading", "label": "Subheading" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Made by hand" },
      { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn more" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "color", "id": "bg_color", "label": "Background color", "default": "#1c1a17" },
      { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
      { "type": "range", "id": "overlay", "label": "Image overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30 }
    ] }
  ]
}
{% endschema %}
