<div class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width">
    <div class="tw-grid tw-gap-10 lg:tw-grid-cols-2 lg:tw-items-center">
      <div class="before-after media media--{{ section.settings.image_ratio }}" data-before-after style="--position: {{ section.settings.start }}%;" data-reveal>
        {%- liquid
          assign before_alt = section.settings.image_before.alt | escape
          assign after_alt = section.settings.image_after.alt | escape
        -%}
        <div class="before-after__layer">
          {%- if section.settings.image_after != blank -%}
            {{ section.settings.image_after | image_url: width: 1500 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1500', alt: after_alt }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="before-after__label tw-right-4">{{ section.settings.label_after }}</span>
        </div>
        <div class="before-after__layer before-after__layer--before">
          {%- if section.settings.image_before != blank -%}
            {{ section.settings.image_before | image_url: width: 1500 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1500', alt: before_alt }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="before-after__label tw-left-4">{{ section.settings.label_before }}</span>
        </div>
        <span class="before-after__handle" aria-hidden="true">{% render 'icon', name: 'chevron-left' %}{% render 'icon', name: 'chevron-right' %}</span>
        <input type="range" class="before-after__range" min="0" max="100" value="{{ section.settings.start }}" aria-label="{{ section.settings.label_before | escape }} / {{ section.settings.label_after | escape }}" data-before-after-range>
      </div>

      <div data-reveal>
        {%- if section.settings.subheading != blank -%}<span class="subheading">{{ section.settings.subheading }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.link | default: '#' }}" class="btn tw-mt-7">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Before / after",
  "class": "section-before-after",
  "settings": [
    { "type": "image_picker", "id": "image_before", "label": "Before image" },
    { "type": "image_picker", "id": "image_after", "label": "After image", "info": "Use two images with the same size and framing" },
    { "type": "text", "id": "label_before", "label": "Before label", "default": "Before" },
    { "type": "text", "id": "label_after", "label": "After label", "default": "After" },
    { "type": "range", "id": "start", "label": "Starting position", "min": 10, "max": 90, "step": 5, "unit": "%", "default": 50 },
    { "type": "select", "id": "image_ratio", "label": "Image shape", "default": "square", "options": [
      { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }, { "value": "landscape", "label": "Landscape" }
    ] },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Ages beautifully" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Leather that gets better with time" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Drag the slider to compare. Show how a product changes with use, care or customisation.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "checkbox", "id": "alt_bg", "label": "Use alternate background", "default": false }
  ],
  "presets": [ { "name": "Before / after" } ]
}
{% endschema %}
