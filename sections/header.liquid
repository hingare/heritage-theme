{%- liquid
  assign menu = section.settings.menu
  assign logo_left = false
  assign nav_inline = false
  assign left_below = false
  if section.settings.logo_position == 'left'
    assign logo_left = true
    assign nav_inline = true
  elsif section.settings.logo_position == 'left-below'
    assign logo_left = true
    assign left_below = true
  endif
  assign overhang = false
  if left_below and section.settings.logo_overhang
    assign overhang = true
  endif
-%}
{%- liquid
  assign transparent = false
  if section.settings.transparent_home and request.page_type == 'index'
    assign transparent = true
  endif
-%}
{%- liquid
  assign search_bar = false
  if section.settings.search_style == 'bar'
    assign search_bar = true
  endif
  assign best_collection = section.settings.search_products_collection
  if best_collection == blank
    assign best_url = routes.all_products_collection_url
  else
    assign best_url = best_collection.url
  endif
-%}
<style>
  #shopify-section-{{ section.id }} { --header-bg-overlay: {{ section.settings.bg_overlay | divided_by: 100.0 }}; --header-bg-text: {{ section.settings.bg_text_color }}; }
  #shopify-section-{{ section.id }} { --logo-width: {{ section.settings.logo_width }}px; --logo-width-mobile: {{ section.settings.logo_width_mobile }}px; }
  {%- if section.settings.sticky %}
  #shopify-section-{{ section.id }} { position: sticky; top: 0; z-index: 30; }
  {%- endif %}
  {%- if transparent %}
  #shopify-section-{{ section.id }} { margin-bottom: calc(-1 * var(--header-height, 76px)); --transparent-header-text: {{ section.settings.transparent_text_color }}; }
  {%- endif %}
</style>

<div class="site-header-wrapper{% if section.settings.sticky %} is-sticky{% endif %}{% if transparent %} site-header-wrapper--transparent{% endif %}" data-header-wrapper>
  <header class="site-header{% if logo_left %} site-header--logo-left{% endif %}{% if left_below %} site-header--left-below{% endif %}{% if overhang %} site-header--overhang{% endif %}{% if section.settings.bg_image != blank %} site-header--has-bg{% endif %}{% if search_bar %} site-header--search-bar{% if section.settings.search_mobile_bar %} site-header--search-bar-mobile{% endif %}{% endif %}" role="banner">
    {%- if section.settings.bg_image != blank -%}
      <div class="site-header__bg" aria-hidden="true">
        {{ section.settings.bg_image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: '' }}
      </div>
    {%- endif -%}
    <div class="page-width site-header__inner">
      <div class="site-header__left">
        <button type="button" class="header-icon site-header__mobile-toggle" data-open="MobileNav" aria-controls="MobileNav" aria-label="{{ 'general.menu' | t }}">
          {% render 'icon', name: 'menu' %}
        </button>
        {%- if logo_left -%}
          {% render 'header-logo', section: section, request: request %}
        {%- else -%}
          <button type="button" class="header-icon header-icon--search" data-open="SearchModal" aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'search' %}</button>
        {%- endif -%}
      </div>

      {%- if nav_inline -%}
        <nav class="site-nav--desktop" aria-label="Primary">
          {% render 'header-nav', menu: menu, section: section, inline: true %}
        </nav>
      {%- elsif left_below -%}
        <div class="site-header__tagline">
          {%- if section.settings.tagline_heading != blank -%}
            <p class="site-header__tagline-heading">{{ section.settings.tagline_heading }}</p>
          {%- endif -%}
          {%- if section.settings.tagline_items != blank -%}
            <ul class="site-header__tagline-items">
              {%- assign tagline_items = section.settings.tagline_items | split: '|' -%}
              {%- for item in tagline_items -%}
                {%- assign item = item | strip -%}
                {%- if item != blank -%}<li>{{ item }}</li>{%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- else -%}
        {% render 'header-logo', section: section, request: request %}
      {%- endif -%}

      <div class="site-header__icons">
        {%- if search_bar -%}
          <button type="button" class="header-search-bar" data-open="SearchModal" data-search-trigger aria-label="{{ 'general.search' | t }}">
            {% render 'icon', name: 'search' %}<span>{{ 'header.search_placeholder' | t }}</span>
          </button>
        {%- endif -%}
        {%- if logo_left -%}
          <button type="button" class="header-icon header-icon--search" data-open="SearchModal" aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'search' %}</button>
        {%- endif -%}
        {%- if shop.customer_accounts_enabled -%}
          <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="header-icon header-icon--account" aria-label="{{ 'general.account' | t }}">
            {% render 'icon', name: 'account' %}
          </a>
        {%- endif -%}
        {%- if settings.wishlist_enabled and settings.wishlist_page != blank -%}
          <a href="{{ settings.wishlist_page.url }}" class="header-icon header-icon--wishlist" aria-label="{{ 'wishlist.title' | t }}">
            {% render 'icon', name: 'heart' %}
            <span class="cart-count" data-wishlist-count data-count="0"></span>
          </a>
        {%- endif -%}
        <a href="{{ routes.cart_url }}" class="header-icon" {% if settings.cart_type == 'drawer' %}data-open="CartDrawer"{% endif %} aria-label="{{ 'general.cart' | t }}">
          {% render 'icon', name: 'cart' %}
          <span class="cart-count" data-cart-count data-count="{{ cart.item_count }}">{% if cart.item_count > 0 %}{{ cart.item_count }}{% endif %}</span>
        </a>
      </div>
    </div>

    {%- if search_bar and section.settings.search_mobile_bar -%}
      <div class="page-width site-header__mobile-search">
        <button type="button" class="header-search-bar" data-open="SearchModal" data-search-trigger aria-label="{{ 'general.search' | t }}">
          {% render 'icon', name: 'search' %}<span>{{ 'header.search_placeholder' | t }}</span>
        </button>
      </div>
    {%- endif -%}
    {%- unless nav_inline -%}
      {%- liquid
        assign nav_bg = section.settings.nav_bg_color
        if nav_bg != blank and nav_bg.alpha == 0
          assign nav_bg = blank
        endif
      -%}
      <div class="site-header__nav-row{% if section.settings.nav_bg_image != blank %} site-header__nav-row--has-bg{% endif %}{% if nav_bg != blank %} site-header__nav-row--color{% endif %}"
        {%- if nav_bg != blank %} style="--nav-bg: {{ nav_bg }}; --nav-text: {{ section.settings.nav_text_color }};"{% endif %}>
        {%- if section.settings.nav_bg_image != blank -%}
          <div class="site-header__bg" aria-hidden="true">
            {{ section.settings.nav_bg_image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '1100, 1500, 2000, 2400', sizes: '100vw', alt: '' }}
          </div>
        {%- endif -%}
        <nav class="page-width site-nav--desktop" aria-label="Primary">
          {% render 'header-nav', menu: menu, section: section, inline: false %}
        </nav>
      </div>
    {%- endunless -%}
  </header>
</div>

{%- comment -%} Mobile navigation drawer {%- endcomment -%}
<div id="MobileNav" class="drawer drawer--left" aria-hidden="true" role="dialog" aria-label="{{ 'general.menu' | t }}">
  <div class="drawer__header">
    <span class="drawer__title h3">{{ 'general.menu' | t }}</span>
    <button type="button" class="drawer__close" data-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
  </div>
  <div class="drawer__body">
    <ul class="mobile-nav">
      {%- for link in menu.links -%}
        <li class="mobile-nav__item">
          {%- if link.links != blank -%}
            <button type="button" class="mobile-nav__toggle" data-mobile-toggle aria-expanded="false" aria-controls="MobileSub-{{ forloop.index }}">
              {{ link.title }} {% render 'icon', name: 'chevron-down' %}
            </button>
            <div class="mobile-nav__sub" id="MobileSub-{{ forloop.index }}">
              <a href="{{ link.url }}"><strong>{{ 'general.view_all' | t }}</strong></a>
              {%- for child in link.links -%}
                {%- if child.links != blank -%}
                  <button type="button" class="mobile-nav__toggle" data-mobile-toggle aria-expanded="false" aria-controls="MobileSub-{{ forloop.parentloop.index }}-{{ forloop.index }}">
                    {{ child.title }} {% render 'icon', name: 'chevron-down' %}
                  </button>
                  <div class="mobile-nav__sub" id="MobileSub-{{ forloop.parentloop.index }}-{{ forloop.index }}">
                    <a href="{{ child.url }}">{{ 'general.view_all' | t }}</a>
                    {%- for grandchild in child.links -%}
                      <a href="{{ grandchild.url }}">{{ grandchild.title }}</a>
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <a href="{{ child.url }}">{{ child.title }}</a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- else -%}
            <a href="{{ link.url }}" class="mobile-nav__link">{{ link.title }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    <div class="mobile-nav__footer">
      {%- if shop.customer_accounts_enabled -%}
        {%- if customer -%}
          <a href="{{ routes.account_url }}" class="btn btn--secondary btn--full">{{ 'customer.account' | t }}</a>
        {%- else -%}
          <a href="{{ routes.account_login_url }}" class="btn btn--secondary btn--full">{{ 'customer.login' | t }}</a>
        {%- endif -%}
      {%- endif -%}
      {% render 'social-icons' %}
    </div>
  </div>
</div>

{%- comment -%} Search overlay {%- endcomment -%}
<div id="SearchModal" class="search-modal{% if search_bar %} search-modal--dropdown{% endif %}" aria-hidden="true" role="dialog" aria-label="{{ 'general.search' | t }}">
  {%- comment -%} React live search (src/react/SearchPanel.jsx) replaces this markup once loaded. {%- endcomment -%}
  <div{% if settings.predictive_search_enabled %} data-react-island="search" data-island-lazy{% endif %}>
  <script type="application/json" data-island-props>
    {
      "unavailable": {{ settings.search_unavailable | default: 'last' | json }},
      "featured": {
        "show": {{ section.settings.search_show_products | json }},
        "url": {{ best_url | json }},
        "title": {{ section.settings.search_products_title | json }},
        "limit": {{ section.settings.search_products_limit | json }}
      },
      "popular": [
        {%- assign popular = section.settings.popular_searches | split: ',' -%}
        {%- for term in popular -%}{{ term | strip | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%}
      ],
      "strings": {
        "search": {{ 'general.search' | t | json }},
        "placeholder": {{ 'header.search_placeholder' | t | json }},
        "close": {{ 'general.close' | t | json }},
        "clear": {{ 'search.clear' | t | json }},
        "recent": {{ 'search.recent' | t | json }},
        "popular": {{ 'search.popular' | t | json }},
        "suggestions": {{ 'search.suggestions' | t | json }},
        "collections": {{ 'search.collections' | t | json }},
        "products": {{ 'search.products' | t | json }},
        "viewAll": {{ 'header.search_view_all' | t | json }},
        "noResults": {{ 'search.no_results' | t | json }}
      }
    }
  </script>
  <div class="page-width">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-modal__form">
      {% render 'icon', name: 'search' %}
      <input type="hidden" name="options[prefix]" value="last">
      <input type="search" name="q" class="search-modal__input" placeholder="{{ 'header.search_placeholder' | t }}" aria-label="{{ 'general.search' | t }}" autocomplete="off"{% if settings.predictive_search_enabled %} data-predictive-input{% endif %}>
      <button type="button" class="header-icon" data-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </form>
    <div class="predictive-search" data-predictive-results></div>
  </div>
  </div>
</div>

{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      {%- if section.settings.logo -%}
        "logo": {{ section.settings.logo | image_url: width: 500 | prepend: 'https:' | json }},
      {%- endif -%}
      "url": {{ request.origin | append: routes.root_url | json }}
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "class": "section-site-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 350,
      "step": 5,
      "unit": "px",
      "default": 160
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Mobile logo width",
      "min": 50,
      "max": 250,
      "step": 5,
      "unit": "px",
      "default": 110
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Layout",
      "default": "center-below",
      "options": [
        {
          "value": "left",
          "label": "Logo left, menu inline"
        },
        {
          "value": "center-below",
          "label": "Logo center, menu below"
        },
        {
          "value": "left-below",
          "label": "Logo left, menu below"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "logo_overhang",
      "label": "Let the logo hang over the menu bar",
      "info": "Layout: logo left, menu below. Works best with a badge-shaped logo.",
      "default": false
    },
    {
      "type": "text",
      "id": "tagline_heading",
      "label": "Tagline heading",
      "info": "Layout: logo left, menu below. Shows next to the logo on desktop."
    },
    {
      "type": "text",
      "id": "tagline_items",
      "label": "Tagline points",
      "info": "Separate with |  e.g. Genuine leather | Handmade | Free shipping"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Enable sticky header",
      "default": true
    },
    {
      "type": "header",
      "content": "Transparent header"
    },
    {
      "type": "checkbox",
      "id": "transparent_home",
      "label": "Transparent header on home page",
      "default": false,
      "info": "Sits over the first section. Works best with a slideshow, image banner or video first."
    },
    {
      "type": "color",
      "id": "transparent_text_color",
      "label": "Text and icon color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "logo_transparent",
      "label": "Logo on transparent header",
      "info": "Optional light version of your logo"
    },
    {
      "type": "header",
      "content": "Background images"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Header background image",
      "info": "Shows behind the logo and icons. 2400 x 300px works well."
    },
    {
      "type": "image_picker",
      "id": "nav_bg_image",
      "label": "Menu bar background image",
      "info": "Shows behind the menu row (layouts with the menu below)."
    },
    {
      "type": "color",
      "id": "nav_bg_color",
      "label": "Menu bar background color",
      "info": "Leave empty for no color. Example: leather brown #6b3e26."
    },
    {
      "type": "color",
      "id": "nav_text_color",
      "label": "Menu bar text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "bg_overlay",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "color",
      "id": "bg_text_color",
      "label": "Text and icon color on images",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "select",
      "id": "search_style",
      "label": "Search style",
      "default": "bar",
      "options": [
        {
          "value": "bar",
          "label": "Visible search box"
        },
        {
          "value": "icon",
          "label": "Icon only"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "search_mobile_bar",
      "label": "Show search box below the header on mobile",
      "info": "Off: phones show the search icon only.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "search_show_products",
      "label": "Show products when search opens",
      "default": true
    },
    {
      "type": "text",
      "id": "search_products_title",
      "label": "Products heading",
      "default": "Best sellers"
    },
    {
      "type": "collection",
      "id": "search_products_collection",
      "label": "Products from collection",
      "info": "Sorted by best selling. Leave empty to use all products."
    },
    {
      "type": "range",
      "id": "search_products_limit",
      "label": "Number of products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "popular_searches",
      "label": "Popular searches",
      "default": "Tote bag, Wallet, Belt",
      "info": "Comma separated. Shown when the search box is empty."
    }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega menu",
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Menu item",
          "info": "Enter the top-level menu title that should open this mega menu, e.g. Women"
        },
        {
          "type": "header",
          "content": "Promotion 1"
        },
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title_1",
          "label": "Heading"
        },
        {
          "type": "url",
          "id": "link_1",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Promotion 2"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title_2",
          "label": "Heading"
        },
        {
          "type": "url",
          "id": "link_2",
          "label": "Link"
        }
      ]
    }
  ]
}
{% endschema %}
