{%- liquid
  assign url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=' | append: section.settings.limit | append: '&intent=' | append: section.settings.intent
-%}
<div class="section">
  <div class="page-width">
    <div data-recommendations data-url="{{ url }}">
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        <div class="section-header section-header--center">
          <h2>{{ section.settings.heading }}</h2>
        </div>
        <div class="grid grid--scroll-mobile" style="--cols: {{ section.settings.columns }};">
          {%- for product in recommendations.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "select", "id": "intent", "label": "Type", "default": "related", "options": [
      { "value": "related", "label": "Related" },
      { "value": "complementary", "label": "Complementary (set in Search & Discovery app)" }
    ] },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 10, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 }
  ],
  "presets": [ { "name": "Product recommendations" } ]
}
{% endschema %}
