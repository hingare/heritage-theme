<div class="password-page" {% if section.settings.image != blank %}style="background: url({{ section.settings.image | image_url: width: 2400 }}) center/cover; color: #fff;"{% endif %}>
  <div class="password-page__inner">
    <h1>{{ shop.name }}</h1>
    <p class="subheading">{{ 'password.opening_soon' | t }}</p>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    {% render 'newsletter-form', form_id: 'PasswordNewsletter' %}
    <details>
      <summary style="cursor: pointer; text-decoration: underline;">{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <div class="newsletter-form">
          <input type="password" name="password" class="input" placeholder="{{ 'customer.password' | t }}" aria-label="{{ 'customer.password' | t }}" autocomplete="current-password">
          <button type="submit" class="btn">{{ 'customer.submit' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" }
  ]
}
{% endschema %}
