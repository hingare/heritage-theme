<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.tagged_with' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {%- liquid
      assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
      assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
    -%}
    {{ settings.type_header_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {{ settings.type_body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    <style>
    {{ settings.type_header_font | font_face: font_display: 'swap' }}
    {{ settings.type_body_font | font_face: font_display: 'swap' }}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    </style>

    {% render 'css-variables' %}

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'tailwind.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          search: {{ routes.search_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          added: {{ 'products.product.added' | t | json }}
        },
        settings: {
          cartType: {{ settings.cart_type | json }},
          moneyFormat: {{ shop.money_format | json }},
          wishlist: {{ settings.wishlist_enabled | json }},
          recentlyViewed: {{ settings.recently_viewed_enabled | json }}
        },
        assets: {
          reactIslands: {{ 'react-islands.js' | asset_url | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'features.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}{% if settings.animations_enabled %} animations-enabled{% endif %}{% if settings.page_transition %} page-transition{% endif %}">
    <a class="skip-link visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}
    {% render 'quick-view-modal' %}

    <div class="overlay" data-overlay></div>

    {%- if settings.back_to_top -%}
      <button type="button" class="back-to-top" data-back-to-top aria-label="{{ 'general.back_to_top' | t }}">{% render 'icon', name: 'arrow-up' %}</button>
    {%- endif -%}
    {%- if template.name == 'product' and settings.recently_viewed_enabled -%}
      <script>
        try {
          var rvKey = 'heritage-recently-viewed';
          var rv = JSON.parse(localStorage.getItem(rvKey) || '[]').filter(function (h) { return h !== {{ product.handle | json }}; });
          rv.unshift({{ product.handle | json }});
          localStorage.setItem(rvKey, JSON.stringify(rv.slice(0, 12)));
        } catch (e) {}
      </script>
    {%- endif -%}
  </body>
</html>
